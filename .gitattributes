# Release tarballs (git archive) ship only what installs and runs Node Manager:
# the CLI, configure.sh, compose files, host helpers and the config files compose mounts.
# The root is default-deny so new top-level files stay out unless re-included below.
/* export-ignore
/LICENSE -export-ignore
/VERSION -export-ignore
/stack -export-ignore
/configure.sh -export-ignore
/docker-compose*.yml -export-ignore

# Maintainer scripts; only the four runtime helpers stay.
/scripts -export-ignore
scripts/* export-ignore
scripts/helper-common.sh -export-ignore
scripts/node-control -export-ignore
scripts/node-manager -export-ignore
scripts/node-port-control -export-ignore
scripts/node-resource-profile -export-ignore

# Docker build inputs for the GHCR images; only the config files compose mounts stay.
/build -export-ignore
build/* export-ignore
build/bitcoin -export-ignore
build/tari -export-ignore
build/zcash -export-ignore
