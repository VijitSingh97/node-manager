#!/usr/bin/env bash
# Single entry point for operating the stack. Run ./stack help for usage.
set -euo pipefail
stack_root=${BITCOIN_STACK_ROOT:-$(cd "$(dirname "$0")" && pwd)}
state_dir=${BITCOIN_STACK_STATE_DIR:-$stack_root}
config_dir=${BITCOIN_STACK_CONFIG_DIR:-$state_dir}
config_file=$config_dir/config.json
env_file=$state_dir/.env
approved_config_file=$state_dir/.approved-config.json
approved_env_file=$state_dir/.approved.env
stack_command=${BITCOIN_STACK_COMMAND:-./stack}
package_managed=${BITCOIN_STACK_PACKAGE_MANAGED:-0}
legacy_project=bitcoin-starter-stack
fresh_project='node-manager-source'
case "$package_managed" in
  brew) legacy_project=bitcoin-starter-stack-brew; fresh_project='node-manager-brew' ;;
  1 | apt) legacy_project=bitcoin-starter-stack-apt; fresh_project='node-manager-apt' ;;
esac
project_name=${BITCOIN_STACK_PROJECT_NAME:-}
if [ -z "$project_name" ] && [ -f "$env_file" ]; then
  project_name=$(sed -n 's/^COMPOSE_PROJECT_NAME=//p' "$env_file" 2>/dev/null | tail -n 1)
fi
if [ -z "$project_name" ]; then
  if [ -f "$env_file" ]; then project_name=$legacy_project; else project_name=$fresh_project; fi
fi
export BITCOIN_STACK_PROJECT_NAME="$project_name"
config_lock_owned=0

lock_config() {
  [ "${BITCOIN_STACK_CONFIG_LOCK_HELD:-0}" != 1 ] || return 0
  mkdir -p "$state_dir"
  exec 8>"$state_dir/.config.lock"
  flock 8
  export BITCOIN_STACK_CONFIG_LOCK_HELD=1
  config_lock_owned=1
}

unlock_config() {
  [ "$config_lock_owned" = 1 ] || return 0
  flock -u 8
  unset BITCOIN_STACK_CONFIG_LOCK_HELD
  config_lock_owned=0
}

replace_config() {
  local source=$1 target
  mkdir -p "$state_dir" "$config_dir"
  lock_config
  target=$(mktemp "$config_dir/.config.write.XXXXXX")
  chmod 600 "$target"
  cat "$source" >"$target"
  mv "$target" "$config_file"
  unlock_config
}

approve_current_config() {
  local source=${1:-$config_file} target env_target config_backup env_backup
  [ -f "$env_file" ] || {
    echo "Cannot approve configuration before it has been rendered." >&2
    return 1
  }
  target=$(mktemp "$state_dir/.approved-config.write.XXXXXX") || return 1
  env_target=$(mktemp "$state_dir/.approved-env.write.XXXXXX") || {
    rm -f "$target"
    return 1
  }
  if [ -f "$source" ]; then
    jq -S . "$source" >"$target" || {
      rm -f "$target" "$env_target"
      return 1
    }
  else
    printf '{}\n' >"$target"
  fi
  if ! cp "$env_file" "$env_target" || ! chmod 600 "$target" "$env_target"; then
    rm -f "$target" "$env_target"
    return 1
  fi
  config_backup=$(mktemp "$state_dir/.approved-config.backup.XXXXXX") || {
    rm -f "$target" "$env_target"
    return 1
  }
  env_backup=$(mktemp "$state_dir/.approved-env.backup.XXXXXX") || {
    rm -f "$target" "$env_target" "$config_backup"
    return 1
  }
  if [ -f "$approved_config_file" ] && ! cp "$approved_config_file" "$config_backup"; then
    rm -f "$target" "$env_target" "$config_backup" "$env_backup"
    return 1
  fi
  if [ -f "$approved_env_file" ] && ! cp "$approved_env_file" "$env_backup"; then
    rm -f "$target" "$env_target" "$config_backup" "$env_backup"
    return 1
  fi
  mv "$target" "$approved_config_file" || {
    rm -f "$target" "$env_target" "$config_backup" "$env_backup"
    return 1
  }
  mv "$env_target" "$approved_env_file" || {
    if [ -s "$config_backup" ]; then cp "$config_backup" "$approved_config_file"; else rm -f "$approved_config_file"; fi
    if [ -s "$env_backup" ]; then cp "$env_backup" "$approved_env_file"; else rm -f "$approved_env_file"; fi
    rm -f "$config_backup" "$env_backup"
    return 1
  }
  rm -f "$config_backup" "$env_backup"
}

approve_existing_runtime() {
  local source
  source=$(mktemp "$state_dir/.approved-runtime.XXXXXX")
  printf 'null\n' >"$source"
  approve_current_config "$source"
  rm -f "$source"
}

config_matches_approved() {
  [ -f "$approved_config_file" ] || return 1
  if [ ! -f "$config_file" ]; then
    jq -e 'type == "object" and length == 0' "$approved_config_file" >/dev/null
    return
  fi
  diff -q <(jq -S . "$config_file") "$approved_config_file" >/dev/null 2>&1
}

render_config_file() {
  local source=$1 temporary_config_dir
  if [ "$source" = "$config_file" ]; then
    "$stack_root/configure.sh"
    return
  fi
  temporary_config_dir=$(mktemp -d "$state_dir/.approved-config.XXXXXX")
  cp "$source" "$temporary_config_dir/config.json"
  BITCOIN_STACK_CONFIG_DIR="$temporary_config_dir" "$stack_root/configure.sh"
  rm -f "$temporary_config_dir/config.json"
  rmdir "$temporary_config_dir"
}

render_current_config() {
  render_config_file "$config_file"
}

render_approved_config() {
  [ ! -f "$approved_env_file" ] || cp "$approved_env_file" "$env_file"
  if jq -e 'type == "null"' "$approved_config_file" >/dev/null; then
    return
  fi
  render_config_file "$approved_config_file"
  approve_current_config "$approved_config_file"
}

prepare_config_for_start() {
  config_was_applied=0
  if [ ! -f "$approved_config_file" ]; then
    if [ -f "$env_file" ]; then
      approve_existing_runtime
    else
      render_current_config
      approve_current_config
      config_was_applied=1
      return
    fi
  fi
  if config_matches_approved; then
    if [ -f "$config_file" ]; then
      render_current_config
      approve_current_config
    else
      cp "$approved_env_file" "$env_file"
      chmod 600 "$env_file"
    fi
    return
  fi

  echo "Config change detected."
  reply=n
  if [ -t 0 ] || [ "${BITCOIN_STACK_INTERACTIVE:-0}" = 1 ]; then
    printf "Run new config? [y/N] "
    read -r reply || true
  else
    echo "Keeping the last approved config. Run $stack_command apply to approve the pending change."
  fi
  case "$reply" in
    y | Y)
      render_current_config
      approve_current_config
      config_was_applied=1
      ;;
    *)
      render_approved_config
      ;;
  esac
}
caller_dir=$PWD
cd "$state_dir"

compose() {
  local -a runner=(docker compose)
  if [ -n "${BITCOIN_STACK_COMPOSE_TIMEOUT_SECONDS:-}" ]; then
    [[ "$BITCOIN_STACK_COMPOSE_TIMEOUT_SECONDS" =~ ^[0-9]+$ ]] &&
      [ "$BITCOIN_STACK_COMPOSE_TIMEOUT_SECONDS" -ge 1 ] &&
      [ "$BITCOIN_STACK_COMPOSE_TIMEOUT_SECONDS" -le 3600 ] || {
      echo "Invalid Compose timeout." >&2
      return 1
    }
    runner=(timeout --foreground --kill-after=30 "$BITCOIN_STACK_COMPOSE_TIMEOUT_SECONDS" docker compose)
  fi
  if [ "$state_dir" = "$stack_root" ]; then
    "${runner[@]}" --project-name "$project_name" "$@"
  else
    local compose_file compose_files=()
    compose_file=$(env_get COMPOSE_FILE)
    compose_file=${compose_file:-docker-compose.yml}
    IFS=: read -ra compose_files <<<"$compose_file"
    local compose_args=()
    for compose_file in "${compose_files[@]}"; do
      case "$compose_file" in
        docker-compose.yml | docker-compose.tari-wallet.yml | docker-compose.rpc.yml | docker-compose.monero-rpc.yml | docker-compose.monero-zmq.yml | docker-compose.tari-grpc.yml | docker-compose.litecoin-rpc.yml | docker-compose.dogecoin-rpc.yml | docker-compose.bitcoincash-rpc.yml | docker-compose.zcash-rpc.yml | docker-compose.utxo-index.yml | docker-compose.litecoin-utxo-index.yml | docker-compose.bitcoincash-utxo-index.yml | docker-compose.dogecoin-utxo-index.yml)
          compose_args+=( -f "$stack_root/$compose_file" )
          ;;
        *)
          echo "Unsupported package Compose file: $compose_file" >&2
          return 1
          ;;
      esac
    done
    "${runner[@]}" --project-name "$project_name" \
      --project-directory "$state_dir" --env-file "$env_file" \
      "${compose_args[@]}" "$@"
  fi
}

container_id() {
  local output
  local -a ids
  output=$(docker ps -aq \
    --filter "label=com.docker.compose.project=$project_name" \
    --filter "label=com.docker.compose.service=$1") || return 1
  ids=()
  [ -z "$output" ] || mapfile -t ids <<<"$output"
  if [ "${#ids[@]}" -gt 1 ]; then
    echo "Multiple $1 containers use the $project_name project identity." >&2
    return 1
  fi
  [ "${#ids[@]}" = 0 ] || printf '%s\n' "${ids[0]}"
}

guard_package_containers() {
  [ "$package_managed" != 0 ] || return 0
  local rows service config working_dir seen=' '
  local guarded=' tor bitcoin monero monero-wallet tari tari-wallet litecoin dogecoin bitcoincash zcash dashboard '
  local legacy_stack_root=${stack_root//node-manager/bitcoin-starter-stack}
  local legacy_state_dir=${state_dir//node-manager/bitcoin-starter-stack}
  if ! rows=$(docker ps -a --filter "label=com.docker.compose.project=$project_name" \
    --format '{{.Label "com.docker.compose.service"}}|{{.ID}}|{{.Label "com.docker.compose.project.config_files"}}|{{.Label "com.docker.compose.project.working_dir"}}'); then
    echo "Existing container ownership could not be queried; package mode will not replace it." >&2
    return 1
  fi
  while IFS='|' read -r service _ config working_dir; do
    case "$guarded" in
      *" $service "*) ;;
      *) continue ;;
    esac
    case "$seen" in
      *" $service "*)
        echo "Multiple $service containers use the $project_name project identity." >&2
        return 1
        ;;
    esac
    seen+="$service "
    if [ -z "$config" ]; then
      echo "Existing $service container ownership could not be verified; package mode will not replace it." >&2
      return 1
    fi
    case ",$config," in
      *",$stack_root/docker-compose.yml,"* | *",$legacy_stack_root/docker-compose.yml,"*) ;;
      *)
        echo "Existing $service container belongs to another installation; package mode will not replace it." >&2
        echo "Keep the source deployment or stop it and plan a manual migration; see docs/operations.md." >&2
        return 1
        ;;
    esac
    if [ "$working_dir" != "$state_dir" ] && [ "$working_dir" != "$legacy_state_dir" ]; then
      echo "Existing $service container belongs to another installation; this installation will not replace it." >&2
      return 1
    fi
  done <<<"$rows"
}
utxo_select_chain() {
  utxo_chain=$1 utxo_arg='' utxo_prefix='' utxo_overlay=docker-compose.utxo-index.yml utxo_volume=utxo_index
  utxo_cli=bitcoin-cli utxo_conf='' utxo_daemon=bitcoind utxo_name=Bitcoin utxo_replay=0 utxo_chainstate=0
  # The family images write their RPC credentials to /tmp/<bin>.conf, not the data directory.
  if [ "$1" = litecoin ]; then
    utxo_arg="litecoin " utxo_prefix=litecoin- utxo_overlay=docker-compose.litecoin-utxo-index.yml utxo_volume=utxo_index_litecoin
    utxo_cli=litecoin-cli utxo_conf=-conf=/tmp/litecoin.conf utxo_daemon=litecoind utxo_name=Litecoin
  elif [ "$1" = bitcoincash ]; then
    utxo_arg="bitcoincash " utxo_prefix=bitcoincash- utxo_overlay=docker-compose.bitcoincash-utxo-index.yml utxo_volume=utxo_index_bitcoincash
    utxo_conf=-conf=/tmp/bitcoin.conf utxo_name="Bitcoin Cash" utxo_chainstate=1
  elif [ "$1" = dogecoin ]; then
    utxo_arg="dogecoin " utxo_prefix=dogecoin- utxo_overlay=docker-compose.dogecoin-utxo-index.yml utxo_volume=utxo_index_dogecoin
    utxo_cli=dogecoin-cli utxo_conf=-conf=/tmp/dogecoin.conf utxo_daemon=dogecoind utxo_name=Dogecoin utxo_chainstate=1
  fi
}

# The node never rewrites a LevelDB table, so the copy hardlinks them as .sst for the dashboard's Pebble reader and copies the rest; the node stops only for the copy.
utxo_chainstate_copy() {
  local node=$1 src dst id file owner ok=1
  utxo_select_chain "$node"
  dst=$(utxo_chainstate_copy_dir "$node")
  src=${dst%/*}/chainstate
  # The node's container writes this directory, so a symlink here could point the copy anywhere.
  [ -d "$src" ] && [ ! -L "$src" ] || {
    echo "There is no chainstate directory at $src." >&2
    return 1
  }
  [ "$(compose exec -T "$node" "$utxo_cli" -datadir=/data ${utxo_conf:+"$utxo_conf"} getblockchaininfo 2>/dev/null | jq -r '.initialblockdownload' 2>/dev/null)" = false ] || {
    echo "$utxo_name RPC did not answer, or the node is still syncing; nothing was changed." >&2
    return 1
  }
  # The hardlinked tables stay on disk after the node rewrites them, until the copy is removed, so the disk must hold the chainstate twice.
  local need free
  need=$(du -sk "$src" 2>/dev/null | awk '{print $1}')
  free=$(df -Pk "${dst%/*}" 2>/dev/null | awk 'NR == 2 {print $4}')
  [ -n "$need" ] && [ -n "$free" ] && [ "$free" -gt "$need" ] || {
    echo "Not enough free space beside the $utxo_name data to keep a copy of its chainstate; nothing was changed." >&2
    return 1
  }
  echo "Stopping $utxo_daemon to copy its chainstate..."
  compose exec -T -u 1000 dashboard touch "/state/$node-chainstate-copy.processing" >/dev/null 2>&1 || true
  # From here the node is down, so an interrupt, a hang-up or a failure starts it again and leaves no partial copy pinning its tables.
  local saved status=0
  saved=$(trap -p INT TERM HUP)
  trap 'rm -rf -- "$dst"; utxo_copy_start "$node" || true; exit 130' INT TERM HUP
  utxo_copy_stopped=1
  if compose stop "$node" >/dev/null 2>&1; then
    id=$(container_id "$node" 2>/dev/null || true)
    # The node's container could swap the chainstate for a symlink until it stopped, so it is checked again now that it cannot.
    if [ -n "$id" ] && [ "$(docker inspect --format '{{.State.Running}}' "$id" 2>/dev/null || true)" = false ] &&
      [ -d "$src" ] && [ ! -L "$src" ] && rm -rf -- "$dst" && mkdir -m 700 "$dst"; then
      for file in "$src"/*; do
        if [ -L "$file" ] || [ ! -f "$file" ]; then
          ok=0
          continue
        fi
        case ${file##*/} in
          LOCK | LOG | LOG.old) ;;
          *.ldb) ln "$file" "$dst/$(basename "$file" .ldb).sst" || ok=0 ;;
          *) cp -p "$file" "$dst/" || ok=0 ;;
        esac
      done
      owner=$(stat -c %u:%g "$src" 2>/dev/null || stat -f %u:%g "$src" 2>/dev/null || true)
      # The dashboard reads the copy as the node's user; if the owner cannot be set, the files' own modes still guard their contents.
      if [ -z "$owner" ] || ! chown "$owner" "$dst" 2>/dev/null; then
        chmod 755 "$dst"
      fi
    else
      ok=0
    fi
  else
    ok=0
  fi
  if utxo_copy_start "$node"; then
    [ "$ok" = 1 ] || status=2
  else
    status=3
  fi
  [ "$status" = 0 ] || rm -rf -- "$dst"
  trap - INT TERM HUP
  [ -z "$saved" ] || eval "$saved"
  return "$status"
}

# The node's data directory as configured, resolved against the state directory like Compose's relative paths.
utxo_chainstate_copy_dir() {
  local root
  root=$(env_get "$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')_DATA_DIR")
  root=${root:-./data/$1}
  case "$root" in /*) ;; *) root=$(cd "$state_dir" && pwd -P)/${root#./} ;; esac
  printf '%s/utxo-seed-chainstate\n' "$root"
}

# The marks hold back the node-down alert while the copy has the node down; a node that fails to start loses them.
utxo_copy_start() {
  local mark="/state/$1-chainstate-copy"
  if compose start "$1" >/dev/null 2>&1; then
    utxo_copy_stopped=0
    compose exec -T -u 1000 dashboard sh -c "touch $mark.status; rm -f $mark.processing" >/dev/null 2>&1 || true
  else
    compose exec -T -u 1000 dashboard rm -f "$mark.processing" >/dev/null 2>&1 || true
    return 1
  fi
}
utxo_select_chain bitcoin
utxo_copy_stopped=0

utxo_seed_overlay_enabled() {
  case ":$(env_get COMPOSE_FILE):" in
    *:"$utxo_overlay":*) return 0 ;;
  esac
  return 1
}

utxo_seed_running() {
  local id
  id=$(container_id "$1" 2>/dev/null) || return 1
  [ -n "$id" ] && [ "$(docker inspect --format '{{.State.Running}}' "$id" 2>/dev/null || true)" = true ]
}

utxo_seed_rpc_methods() {
  compose exec -T "$utxo_chain" "$utxo_cli" -datadir=/data ${utxo_conf:+"$utxo_conf"} getrpcinfo 2>/dev/null | jq -r '.active_commands[].method'
}

utxo_seed_status() {
  compose exec -T -u 1000 dashboard cat "/state/${utxo_prefix}utxo-seed.json" 2>/dev/null
}

utxo_seed_state() {
  utxo_seed_status | jq -r '.seed_state // ""' 2>/dev/null || true
}

utxo_seed_request_cancel() {
  compose exec -T -u 1000 dashboard sh -c "umask 077; : > /state/${utxo_prefix}utxo-seed.cancel"
}

utxo_seed_remove_pipe() {
  compose exec -T "$utxo_chain" rm -f /data/utxo-seed.dat /data/utxo-seed.dat.incomplete >/dev/null 2>&1 || true
}

utxo_seed_unpark() {
  utxo_seed_rpc_methods 2>/dev/null | grep -qx dumptxoutset || return 0
  compose exec -T "$utxo_chain" sh -c 'timeout 5 cat /data/utxo-seed.dat.incomplete >/dev/null' || true
}

utxo_seed_finish_pipe() {
  [ "$utxo_replay" = 1 ] && return 0
  if [ "$utxo_chainstate" = 1 ]; then
    rm -rf -- "$(utxo_chainstate_copy_dir "$utxo_chain")"
    # A node the owner stopped during the seed stays stopped; only one the copy left down is started.
    if [ "$utxo_copy_stopped" = 1 ]; then
      utxo_copy_start "$utxo_chain" || true
    fi
    return 0
  fi
  utxo_seed_unpark
  utxo_seed_remove_pipe
}

utxo_seed_interval() {
  local value=${!1:-} fallback=$2
  if [[ "$value" =~ ^[0-9]+$ ]] && [ "$value" -ge 1 ]; then printf '%s' "$value"; else printf '%s' "$fallback"; fi
}

utxo_seed_cancel() {
  if ! utxo_seed_overlay_enabled || ! utxo_seed_running dashboard; then
    echo "The UTXO index overlay is not enabled or the dashboard is not running." >&2
    return 1
  fi
  utxo_seed_request_cancel || return 1
  if [ "$utxo_chain" = bitcoincash ]; then
    echo "Cancel requested. The dashboard stops the seed within a few seconds; a replay keeps the blocks it has applied."
  elif [ "$utxo_replay" = 1 ]; then
    echo "Cancel requested. The dashboard stops the replay within a few seconds and keeps the blocks it has applied."
  else
    echo "Cancel requested. The dashboard stops the seed within a few seconds and discards the partial index."
  fi
}

utxo_seed() {
  case "${1:-}" in
    litecoin | bitcoincash | dogecoin)
      utxo_select_chain "$1"
      shift
      ;;
  esac
  if [ "${1:-}" = cancel ] && [ $# = 1 ]; then
    utxo_seed_cancel
    return
  fi
  local assume_yes=0 replay_flag=0 bad_arg=0 arg
  for arg in "$@"; do
    case "$arg" in
      -y) assume_yes=1 ;;
      --replay) replay_flag=1 ;;
      *) bad_arg=1 ;;
    esac
  done
  if [ "$bad_arg" = 1 ] || { [ "$replay_flag" = 1 ] && [ "$utxo_chain" != bitcoincash ]; }; then
    echo "Usage: $stack_command utxo-seed [litecoin | bitcoincash | dogecoin] [-y | cancel] (bitcoincash also takes --replay)" >&2
    return 1
  fi
  [ "$replay_flag" != 1 ] || utxo_replay=1 utxo_chainstate=0
  command -v jq >/dev/null || {
    echo "jq is required; install it with your host package manager." >&2
    return 1
  }
  utxo_seed_overlay_enabled || {
    echo "The UTXO index is not enabled. Set $utxo_chain.utxo_index to true in config.json and run $stack_command apply." >&2
    return 1
  }
  local service
  for service in "$utxo_chain" dashboard; do
    utxo_seed_running "$service" || {
      echo "The $service container is not running." >&2
      return 1
    }
  done
  if [ "$utxo_replay" = 1 ]; then
    cat <<EOF
Replaying the $utxo_name balance index from genesis
  - Applies every block through the node's RPC: a one-time job whose mainnet duration is not measured yet.
  - Needs an archival node ($utxo_chain.prune_mb 0); a pruned node is refused.
  - $utxo_name RPC keeps answering and node-down alerts are not held; heat pauses the replay.
  - A stop keeps the blocks already applied, and the next seed resumes from there.
  - Only one balance index seeds at a time. Cancel with: $stack_command utxo-seed ${utxo_arg}cancel
EOF
  elif [ "$utxo_chainstate" = 1 ]; then
    cat <<EOF
Seeding the $utxo_name balance index from the node's chainstate
  - Stops the $utxo_name node while its chainstate is copied, then starts it again; this works on a pruned node.
  - The dashboard then builds the index from the copy; its time and size on mainnet are not measured yet.
  - Only one balance index seeds at a time. Cancel with: $stack_command utxo-seed ${utxo_arg}cancel
EOF
  elif [ "$utxo_chain" = litecoin ]; then
    cat <<EOF
Seeding the Litecoin balance index
  - Litecoin RPC stops answering while litecoind writes the coin set, then answers slowly until the seed ends.
  - Its time and size on mainnet are not measured yet; 27 GB of free space is needed.
  - Litecoin node-down alerts are held for up to 15 minutes, and only one balance index seeds at a time.
  - Cancel with: $stack_command utxo-seed litecoin cancel
EOF
  else
    cat <<EOF
Seeding the Bitcoin balance index
  - Takes about 20 minutes, longer if heat pauses it.
  - Bitcoin RPC stops answering for about 5 minutes, then answers slowly until the seed ends.
  - The index takes about 7.5 GiB afterwards and up to about 17 GiB while it runs; 27 GB of free space is needed.
  - Node-down alerts are held for up to 15 minutes; the dashboard shows when they resume.
  - Pause other heavy chains (for example Tari) first.
  - Cancel with: $stack_command utxo-seed cancel
EOF
  fi
  if [ "$assume_yes" != 1 ]; then
    [ -t 0 ] || [ "${BITCOIN_STACK_INTERACTIVE:-0}" = 1 ] || {
      echo "Run this on a terminal, or pass -y." >&2
      return 1
    }
    local reply
    printf 'Start the seed? [y/N] '
    read -r reply || true
    case "$reply" in
      y | Y) ;;
      *)
        echo "Not started."
        return 1
        ;;
    esac
  fi
  local methods
  if [ "$utxo_chainstate" = 1 ]; then
    :
  elif ! methods=$(utxo_seed_rpc_methods); then
    echo "$utxo_name RPC did not answer; nothing was changed." >&2
    return 1
  fi
  if [ "$utxo_replay" != 1 ] && [ "$utxo_chainstate" != 1 ] && printf '%s\n' "$methods" | grep -Eqx 'dumptxoutset|scantxoutset'; then
    echo "A UTXO dump or scan is already running in $utxo_daemon; nothing was changed." >&2
    return 1
  fi
  case "$(utxo_seed_state)" in
    checking | seeding)
      echo "The dashboard is already seeding the index; nothing was changed." >&2
      return 1
      ;;
  esac
  trap 'trap - INT TERM; compose exec -T -u 1000 dashboard rm -f "/state/${utxo_prefix}utxo-seed.request" >/dev/null 2>&1 || true; utxo_seed_finish_pipe; echo; exit 130' INT TERM
  if [ "$utxo_chainstate" = 1 ]; then
    utxo_chainstate_copy "$utxo_chain" || {
      local copy_status=$?
      trap - INT TERM
      utxo_seed_finish_pipe
      case "$copy_status:$utxo_copy_stopped" in
        1:*) echo "No seed was started; nothing was changed." >&2 ;;
        *:0) echo "No seed was started: the $utxo_name chainstate could not be copied, and the node was started again." >&2 ;;
        *) echo "No seed was started, and the $utxo_name node did not start again; start it with: $stack_command up" >&2 ;;
      esac
      return 1
    }
  elif [ "$utxo_replay" != 1 ]; then
    utxo_seed_remove_pipe
    compose exec -T "$utxo_chain" mkfifo -m 600 /data/utxo-seed.dat.incomplete || {
      trap - INT TERM
      echo "Could not create the seed pipe in the $utxo_chain container." >&2
      return 1
    }
  fi
  local id
  id=$(head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n')
  local seed_mode=
  [ "$utxo_chainstate" != 1 ] || seed_mode=chainstate
  [ "$utxo_replay" != 1 ] || seed_mode=replay
  if ! jq -nc --arg id "$id" --argjson at "$(date +%s)" --arg mode "$seed_mode" '{id:$id,requested_at:$at} + if $mode == "" then {} else {mode:$mode} end' |
    compose exec -T -u 1000 dashboard sh -c \
      "umask 077; cat > /state/.${utxo_prefix}utxo-seed.request.tmp; mv /state/.${utxo_prefix}utxo-seed.request.tmp /state/${utxo_prefix}utxo-seed.request" >/dev/null; then
    utxo_seed_finish_pipe
    trap - INT TERM
    echo "Could not write the seed request into the dashboard state." >&2
    return 1
  fi
  local poll ack_deadline status acked=0
  poll=$(utxo_seed_interval BITCOIN_STACK_UTXO_SEED_POLL_SECONDS 2)
  ack_deadline=$((SECONDS + $(utxo_seed_interval BITCOIN_STACK_UTXO_SEED_ACK_SECONDS 60)))
  while true; do
    status=$(utxo_seed_status || true)
    if [ "$(jq -r '.request_id // ""' <<<"$status" 2>/dev/null || true)" = "$id" ]; then
      acked=1
      break
    fi
    [ "$SECONDS" -lt "$ack_deadline" ] || break
    sleep "$poll"
  done
  if [ "$acked" != 1 ]; then
    compose exec -T -u 1000 dashboard rm -f "/state/${utxo_prefix}utxo-seed.request" >/dev/null 2>&1 || true
    utxo_seed_finish_pipe
    trap - INT TERM
    echo "The dashboard did not acknowledge the request. Check that it is healthy and has the UTXO index enabled." >&2
    return 1
  fi
  local lost_deadline lost_after
  lost_after=$(utxo_seed_interval BITCOIN_STACK_UTXO_SEED_LOST_SECONDS 60)
  lost_deadline=$((SECONDS + lost_after))
  trap 'echo; echo "Detached. The seed keeps running; cancel with: $stack_command utxo-seed ${utxo_arg}cancel"; exit 130' INT TERM
  local line last='' state='' phase='' pct=0
  while true; do
    status=$(utxo_seed_status || true)
    if [ "$(jq -r '.request_id // ""' <<<"$status" 2>/dev/null || true)" = "$id" ]; then
      lost_deadline=$((SECONDS + lost_after))
      state=$(jq -r '.seed_state // ""' <<<"$status")
      phase=$(jq -r '.phase // ""' <<<"$status")
      pct=$(jq -r '((.progress // 0) * 100) | floor' <<<"$status")
      line="$state ${phase:+$phase }${pct}%"
      [ "$line" = "$last" ] || echo "$line"
      last=$line
      case "$state" in
        ok | failed | cancelled | refused) break ;;
      esac
    elif [ "$SECONDS" -ge "$lost_deadline" ]; then
      trap - INT TERM
      utxo_seed_finish_pipe
      echo "Lost track of the seed: the dashboard status no longer matches this request." >&2
      return 1
    fi
    sleep "$poll"
  done
  trap - INT TERM
  utxo_seed_finish_pipe
  jq -r '.refusals[]? | "refused: \(.guard): \(.detail)"' <<<"$status"
  case "$state" in
    ok)
      echo "Seed finished. The index now follows new blocks."
      ;;
    failed | cancelled)
      local kept="The partial index was discarded."
      [ "$utxo_replay" = 1 ] && kept="The index keeps the blocks it applied; the next seed resumes from there."
      if [ "$state" = failed ]; then
        echo "Seed failed: $(jq -r '.last_seed.reason // "unknown"' <<<"$status"). $kept" >&2
      else
        echo "Seed cancelled. $kept" >&2
      fi
      return 1
      ;;
    *) return 1 ;;
  esac
}

utxo_index_remove() {
  case "${1:-}" in
    litecoin | bitcoincash | dogecoin)
      utxo_select_chain "$1"
      shift
      ;;
  esac
  local assume_yes=0
  if [ "${1:-}" = -y ] && [ $# = 1 ]; then
    assume_yes=1
  elif [ $# != 0 ]; then
    echo "Usage: $stack_command utxo-index remove [litecoin | bitcoincash | dogecoin] [-y]" >&2
    return 1
  fi
  if utxo_seed_overlay_enabled; then
    echo "$utxo_chain.utxo_index is still on. Set it to false in config.json and run $stack_command apply first." >&2
    return 1
  fi
  local volume=${project_name}_$utxo_volume
  local listed
  listed=$(docker volume ls -q --filter "name=$volume") || {
    echo "Could not list Docker volumes. Is Docker running?" >&2
    return 1
  }
  printf '%s\n' "$listed" | grep -qxF "$volume" || {
    echo "Nothing to remove: volume $volume does not exist."
    return 0
  }
  if [ -n "$(docker ps -aq --filter "volume=$volume" 2>/dev/null)" ]; then
    echo "A container still mounts $volume. Run $stack_command apply so the dashboard is recreated without it." >&2
    return 1
  fi
  echo "This permanently removes the balance index volume $volume."
  if [ "$assume_yes" != 1 ]; then
    [ -t 0 ] || [ "${BITCOIN_STACK_INTERACTIVE:-0}" = 1 ] || {
      echo "Run this on a terminal, or pass -y." >&2
      return 1
    }
    local reply
    printf 'Remove it? [y/N] '
    read -r reply || true
    case "$reply" in
      y | Y) ;;
      *)
        echo "Not removed."
        return 1
        ;;
    esac
  fi
  docker volume rm "$volume" >/dev/null || return 1
  echo "Removed $volume. Turning $utxo_chain.utxo_index on again starts not_seeded and needs a new $stack_command utxo-seed${utxo_arg:+ ${utxo_arg% }}."
}

utxo_bench_print() {
  local result=$1 tab=$'\t'
  jq -r '(.refusals // [])[] | "refused: " + .' <<<"$result"
  jq -r '(.failures // [])[] | "FAILED: " + .' <<<"$result"
  jq -e '(.wallets // []) | length > 0' <<<"$result" >/dev/null || return 0
  jq -r '"\(if (.chain // "bitcoin") == "bitcoin" then "Index" else "\(.chain) index" end) \(.state) at height \(.index_tip_height // "?"), node at \(.node_tip_height // "?"), repeat \(.repeat)"' <<<"$result"
  jq -r '[.wallets[] | select(.fallback)] | length | select(. > 0) | "warning: \(.) wallet(s) fell back (shape not indexed) and are left out of the lookups, batches and scan comparison."' <<<"$result"
  echo
  echo "Per wallet (seconds):"
  jq -r 'def f: if . == null then "-" else ((. * 10000 | round) / 10000 | tostring) end;
    (["wallet", "scripts", "coins", "sats", "derive", "first", "p50", "p99", "max"] | join("\t")),
    (.wallets[] | [.name, .scripts, .coins, .sats, (.derive_s | f), (if .fallback then "fallback" else (.lookup.first_s | f) end), (.lookup.p50_s | f), (.lookup.p99_s | f), (.lookup.max_s | f)] | join("\t"))' <<<"$result" | { column -t -s "$tab" 2>/dev/null || cat; }
  echo
  echo "Batched lookups (seconds):"
  jq -r 'def f: if . == null then "-" else ((. * 10000 | round) / 10000 | tostring) end;
    (["wallets", "scripts", "expected", "fallback", "coins", "first", "p50", "p99", "max"] | join("\t")),
    ((.batches // [])[] | [.wallets, .scripts, .expected_scripts, .fallback_wallets, .coins, (.lookup.first_s | f), (.lookup.p50_s | f), (.lookup.p99_s | f), (.lookup.max_s | f)] | join("\t"))' <<<"$result" | { column -t -s "$tab" 2>/dev/null || cat; }
  jq -r 'def f: ((. * 10000 | round) / 10000 | tostring);
    if .cached_read then "\nCached read (seconds): p50 \(.cached_read.p50_s | f), p99 \(.cached_read.p99_s | f), max \(.cached_read.max_s | f), roster wallets \(.cached_read.roster_wallets // "?")" else empty end' <<<"$result"
  jq -r 'select(.cached_read and (.cached_read.roster_wallets // 0) == 0) | "note: the watch roster is empty, so the cached read figure does not count."' <<<"$result"
  jq -e '.scan' <<<"$result" >/dev/null 2>&1 || return 0
  echo
  jq -r 'def f: ((. * 10000 | round) / 10000 | tostring);
    "Without the index (scantxoutset): batch of \([.wallets[] | select(.fallback | not)] | length) \(.scan.batch_s | f) s at height \(.scan.batch_height); each wallet alone, in seconds:"' <<<"$result"
  jq -r 'def f: ((. * 10000 | round) / 10000 | tostring);
    (["wallet", "height", "scan", "index_p50", "faster", "scan_coins", "index_coins", "scan_sats", "index_sats", "match"] | join("\t")),
    ([.wallets, (.scan.wallets // [])] | transpose[] | select(.[1]) | .[0].lookup.p50_s as $p50 | .[0].fallback as $fallback | .[1] |
      if $fallback then [.name, "-", "fallback", "-", "-", "-", "-", "-", "-", "n/a"] else
        [.name, .height, (.scan_s | f), ($p50 // null | if . == null then "-" else f end), (if ($p50 // 0) > 0 then "\(.scan_s / $p50 | round)x" else "-" end),
         .coins, .index_coins, .sats, .index_sats, (.match | if . == null then "n/a" else tostring end)] end | join("\t"))' <<<"$result" | { column -t -s "$tab" 2>/dev/null || cat; }
  jq -r 'select([(.scan.wallets // [])[] | select(.match == null)] | length > 0) | "note: n/a is a wallet the index does not serve, or one whose scan ran at another block than its index lookup; repeat the run for the second."' <<<"$result"
}

utxo_index_bench() {
  local usage="Usage: $stack_command utxo-index bench <wallets.json> [--chain bitcoin|litecoin] [--scan [-y]] [--repeat N]"
  local file='' scan=false repeat=20 assume_yes=0 chain=bitcoin
  while [ $# -gt 0 ]; do
    case "$1" in
      --scan) scan=true ;;
      -y) assume_yes=1 ;;
      --chain)
        [ $# -ge 2 ] || {
          echo "$usage" >&2
          return 1
        }
        shift
        chain=$1
        ;;
      --repeat)
        [ $# -ge 2 ] || {
          echo "$usage" >&2
          return 1
        }
        shift
        repeat=$1
        ;;
      -*)
        echo "$usage" >&2
        return 1
        ;;
      *)
        [ -z "$file" ] || {
          echo "$usage" >&2
          return 1
        }
        file=$1
        ;;
    esac
    shift
  done
  if [ -z "$file" ] || ! [[ "$repeat" =~ ^[0-9]+$ ]] || [ "$repeat" -lt 1 ] || [ "$repeat" -gt 200 ]; then
    echo "$usage" >&2
    echo "--repeat takes a number from 1 to 200." >&2
    return 1
  fi
  utxo_select_chain "$chain"
  [ "$chain" != dogecoin ] || {
    echo "Dogecoin is not in utxo-index bench: Dogecoin Core 1.14.9 has no getdescriptorinfo, deriveaddresses or scantxoutset to read wallets and compare against. Its index is checked by a regtest test against the node's gettxout instead." >&2
    return 1
  }
  [ "$chain" = bitcoin ] || [ -n "$utxo_prefix" ] || {
    echo "$usage" >&2
    echo "--chain takes a chain with a balance index." >&2
    return 1
  }
  case "$file" in
    /*) ;;
    *) file=$caller_dir/$file ;;
  esac
  [ -r "$file" ] || {
    echo "Cannot read $file." >&2
    return 1
  }
  command -v jq >/dev/null || {
    echo "jq is required; install it with your host package manager." >&2
    return 1
  }
  utxo_seed_overlay_enabled || {
    echo "The $utxo_name balance index is not enabled. Set $utxo_chain.utxo_index to true in config.json and run $stack_command apply." >&2
    return 1
  }
  jq -e 'type == "array" and length >= 1 and length <= 50 and all(.[]; type == "object" and (.name | type == "string" and length > 0) and (.key | type == "string" and length > 0))' "$file" >/dev/null 2>&1 || {
    echo "$file must be a JSON array of 1 to 50 {\"name\", \"key\"} objects with string values." >&2
    return 1
  }
  utxo_seed_running dashboard || {
    echo "The dashboard container is not running." >&2
    return 1
  }
  local id request
  id=$(head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n')
  request=$(jq -c --arg id "$id" --arg chain "$chain" --argjson at "$(date -u +%s)" --argjson repeat "$repeat" --argjson scan "$scan" '{id: $id, chain: $chain, requested_at: $at, wallets: map({name, key}), repeat: $repeat, scan: $scan}' "$file") || return 1
  if [ "$scan" = true ]; then
    cat <<EOF
This run uses scantxoutset, which is heavy: one scan for all wallets and one per
wallet, each minutes of CPU on a 0.5-CPU mainnet node, and $utxo_daemon RPC answers
slowly meanwhile. Run it only in a window the owner approved.
EOF
    if [ "$assume_yes" != 1 ]; then
      [ -t 0 ] || [ "${BITCOIN_STACK_INTERACTIVE:-0}" = 1 ] || {
        echo "Run this on a terminal, or pass -y." >&2
        return 1
      }
      local reply
      printf 'Start the scan? [y/N] '
      read -r reply || true
      case "$reply" in
        y | Y) ;;
        *)
          echo "Not started."
          return 1
          ;;
      esac
    fi
  fi
  trap 'trap - INT TERM HUP; compose exec -T -u 1000 dashboard rm -f "/state/${utxo_prefix}utxo-bench.request" >/dev/null 2>&1 || true; echo; echo "Detached. The dashboard may still finish the run; the result stays in its state volume." >&2; exit 130' INT TERM HUP
  if ! printf '%s\n' "$request" |
    compose exec -T -u 1000 dashboard sh -c \
      "umask 077; cat > /state/.${utxo_prefix}utxo-bench.request.tmp; mv /state/.${utxo_prefix}utxo-bench.request.tmp /state/${utxo_prefix}utxo-bench.request" >/dev/null; then
    trap - INT TERM HUP
    echo "Could not write the bench request into the dashboard state." >&2
    return 1
  fi
  local poll limit=600 deadline result=''
  if [ "$scan" = true ]; then
    limit=$((780 + ($(jq length "$file") + 1) * 300))
    [ "$limit" -ge 2700 ] || limit=2700
  fi
  poll=$(utxo_seed_interval BITCOIN_STACK_UTXO_BENCH_POLL_SECONDS 5)
  deadline=$((SECONDS + $(utxo_seed_interval BITCOIN_STACK_UTXO_BENCH_TIMEOUT_SECONDS "$limit")))
  echo "Waiting for the dashboard to finish the bench..."
  while true; do
    result=$(compose exec -T -u 1000 dashboard cat "/state/${utxo_prefix}utxo-bench.result" 2>/dev/null || true)
    [ "$(jq -r '.id // ""' <<<"$result" 2>/dev/null || true)" != "$id" ] || break
    if [ "$SECONDS" -ge "$deadline" ]; then
      compose exec -T -u 1000 dashboard rm -f "/state/${utxo_prefix}utxo-bench.request" >/dev/null 2>&1 || true
      trap - INT TERM HUP
      echo "The dashboard returned no result in time. Check that it is healthy and has the $utxo_name balance index enabled." >&2
      return 1
    fi
    sleep "$poll"
  done
  trap - INT TERM HUP
  local saved
  saved=$state_dir/${utxo_prefix}utxo-bench-$(date -u +%Y%m%dT%H%M%SZ).json
  if ! (umask 077 && printf '%s\n' "$result" >"$saved"); then
    echo "Could not save the result under $state_dir." >&2
    return 1
  fi
  utxo_bench_print "$result"
  echo
  echo "Saved $saved (mode 600)."
  [ "$(jq -r '(.refusals // []) + (.failures // []) | length' <<<"$result")" = 0 ]
}

utxo_verify_print() {
  local result=$1 tab=$'\t'
  jq -r '(.refusals // [])[] | "refused: " + .' <<<"$result"
  jq -e '.index and .node' <<<"$result" >/dev/null || return 0
  jq -r '"At height \(.height) (block \(.best_block)), gettxoutsetinfo hash_type \(.hash_type):"' <<<"$result"
  jq -r '(["", "coins", "amount", "seconds"] | join("\t")),
    (["index", "node"][] as $side | [$side, .[$side].coins, .[$side].amount, ((.[$side].seconds * 10 | round) / 10)] | join("\t"))' <<<"$result" | { column -t -s "$tab" 2>/dev/null || cat; }
  jq -r '(.failures // [])[] | "FAIL: " + .' <<<"$result"
  jq -r 'select(.match == true) | "PASS: the index matches the node'"'"'s UTXO set."' <<<"$result"
}

utxo_index_verify() {
  local usage="Usage: $stack_command utxo-index verify [--chain bitcoin|litecoin|dogecoin|bitcoincash] [-y]"
  local chain=bitcoin assume_yes=0 hash_note
  while [ $# -gt 0 ]; do
    case "$1" in
      -y) assume_yes=1 ;;
      --chain)
        [ $# -ge 2 ] || {
          echo "$usage" >&2
          return 1
        }
        shift
        chain=$1
        ;;
      *)
        echo "$usage" >&2
        return 1
        ;;
    esac
    shift
  done
  utxo_select_chain "$chain"
  [ "$chain" = bitcoin ] || [ -n "$utxo_prefix" ] || {
    echo "$usage" >&2
    echo "--chain takes a chain with a balance index." >&2
    return 1
  }
  command -v jq >/dev/null || {
    echo "jq is required; install it with your host package manager." >&2
    return 1
  }
  utxo_seed_overlay_enabled || {
    echo "The $utxo_name balance index is not enabled. Set $utxo_chain.utxo_index to true in config.json and run $stack_command apply." >&2
    return 1
  }
  local service
  for service in "$utxo_chain" dashboard; do
    utxo_seed_running "$service" || {
      echo "The $service container is not running." >&2
      return 1
    }
  done
  hash_note="with hash_type none, which skips the set hash"
  [ "$chain" != dogecoin ] || hash_note="with no arguments: Dogecoin Core 1.14.9 has no hash_type, so it also hashes the whole set"
  cat <<EOF
This compares the $utxo_name balance index with the node's own UTXO set at the same block.
  - The dashboard waits up to 10 minutes for the index to reach the node tip.
  - It then calls $utxo_daemon gettxoutsetinfo $hash_note.
    That call reads the whole chainstate: minutes of disk and CPU on mainnet.
  - The walk does not hold the node's main lock, so $utxo_name RPC keeps answering.
    Node-down alerts for $utxo_name are still held while it runs, for at most 30 minutes.
  - The index stays at the compared block until the check ends, then catches up.
Run it in a window the owner approved.
EOF
  if [ "$assume_yes" != 1 ]; then
    [ -t 0 ] || [ "${BITCOIN_STACK_INTERACTIVE:-0}" = 1 ] || {
      echo "Run this on a terminal, or pass -y." >&2
      return 1
    }
    local reply
    printf 'Start the check? [y/N] '
    read -r reply || true
    case "$reply" in
      y | Y) ;;
      *)
        echo "Not started."
        return 1
        ;;
    esac
  fi
  local id request
  id=$(head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n')
  request=$(jq -cn --arg id "$id" --arg chain "$chain" --argjson at "$(date -u +%s)" '{id: $id, chain: $chain, requested_at: $at}') || return 1
  trap 'trap - INT TERM HUP; compose exec -T -u 1000 dashboard rm -f "/state/${utxo_prefix}utxo-verify.request" >/dev/null 2>&1 || true; echo; echo "Detached. A check already under way still finishes; its result stays in the dashboard state volume." >&2; exit 130' INT TERM HUP
  if ! printf '%s\n' "$request" |
    compose exec -T -u 1000 dashboard sh -c \
      "umask 077; cat > /state/.${utxo_prefix}utxo-verify.request.tmp; mv /state/.${utxo_prefix}utxo-verify.request.tmp /state/${utxo_prefix}utxo-verify.request" >/dev/null; then
    trap - INT TERM HUP
    echo "Could not write the verify request into the dashboard state." >&2
    return 1
  fi
  local poll deadline result=''
  poll=$(utxo_seed_interval BITCOIN_STACK_UTXO_VERIFY_POLL_SECONDS 5)
  deadline=$((SECONDS + $(utxo_seed_interval BITCOIN_STACK_UTXO_VERIFY_TIMEOUT_SECONDS 2700)))
  echo "Waiting for the dashboard to finish the check..."
  while true; do
    result=$(compose exec -T -u 1000 dashboard cat "/state/${utxo_prefix}utxo-verify.result" 2>/dev/null || true)
    [ "$(jq -r '.id // ""' <<<"$result" 2>/dev/null || true)" != "$id" ] || break
    utxo_seed_running dashboard || {
      trap - INT TERM HUP
      echo "The dashboard stopped before the check finished, so nothing was compared. Run it again once the dashboard is back; if the check had started, the node may still be walking its UTXO set for a few minutes." >&2
      return 1
    }
    if [ "$SECONDS" -ge "$deadline" ]; then
      compose exec -T -u 1000 dashboard rm -f "/state/${utxo_prefix}utxo-verify.request" >/dev/null 2>&1 || true
      trap - INT TERM HUP
      echo "The dashboard returned no result in time. Check that it is healthy and has the $utxo_name balance index enabled." >&2
      return 1
    fi
    sleep "$poll"
  done
  trap - INT TERM HUP
  utxo_verify_print "$result"
  jq -e '.match == true' <<<"$result" >/dev/null
}

utxo_unpark_dump() {
  local chain
  for chain in bitcoin litecoin; do
    utxo_select_chain "$chain"
    utxo_unpark_chain "$@"
  done
  utxo_select_chain bitcoin
}

utxo_unpark_chain() {
  utxo_seed_overlay_enabled || return 0
  local arg hit=1 methods
  for arg in "$@"; do
    case "$arg" in
      -* | [0-9]*) ;;
      "$utxo_chain")
        hit=1
        break
        ;;
      *) hit=0 ;;
    esac
  done
  [ "$hit" = 1 ] || return 0
  guard_package_containers >/dev/null 2>&1 || return 0
  utxo_seed_running "$utxo_chain" || return 0
  methods=$(utxo_seed_rpc_methods) || return 0
  printf '%s\n' "$methods" | grep -qx dumptxoutset || return 0
  if utxo_seed_running dashboard && [ "$(utxo_seed_state)" = seeding ]; then
    echo "Cancelling the running UTXO seed so $utxo_daemon can stop."
    utxo_seed_request_cancel >/dev/null 2>&1 || true
    local deadline=$((SECONDS + $(utxo_seed_interval BITCOIN_STACK_UTXO_SEED_CANCEL_SECONDS 15)))
    while [ "$SECONDS" -lt "$deadline" ] && [ "$(utxo_seed_state)" = seeding ]; do
      sleep 1
    done
  fi
  echo "A UTXO dump is running; opening its pipe once so $utxo_daemon can stop."
  utxo_seed_unpark
}

usage() {
  cat <<EOF
Usage: $stack_command <command> [args]

  up | down | restart [svc]  Start / stop / restart the stack (or one service)
  up --force-recreate svc    Recreate a service whose container failed to start
  pull                       Download container images using host Docker settings
  init                       Create the default config, download images, and start
  logs [svc]                 Follow logs (all services, or one)
  events                     Incident history (down/recovered, failed pings) — survives restarts
  apply                      Re-render .env from config.json and apply changes
  upgrade                    Show manual APT, Homebrew, and GitHub update steps
  upgrade-agent              Compatibility alias for host-service
  host-service               Supervise configured nodes and host controls
  status                     Container + health summary; warns on anything down
  doctor                     Read-only health report (deps, disk, sync, tor)
  backup                     Save config, credentials, and onion keys to backups/
  restore [-y] <archive>     Restore a backup archive (prompts before overwrite)
  utxo-seed [litecoin | bitcoincash | dogecoin] [-y | cancel]
                             Seed or cancel a balance index (needs <chain>.utxo_index); bitcoincash --replay replays every block of an archival node
  utxo-index remove [litecoin] [-y]
                             Delete the balance index volume (needs <chain>.utxo_index off and applied)
  utxo-index bench <file> [--chain bitcoin|litecoin] [--scan [-y]] [--repeat N]
                             Time balance lookups for the wallets in <file> (needs the index seeded)
  utxo-index verify [--chain bitcoin|litecoin|dogecoin|bitcoincash] [-y]
                             Compare the index's coin count and total with the node's gettxoutsetinfo (run after a seed)
  help                       This text
EOF
}

env_get() { sed -n "s/^$1=//p" "$env_file" 2>/dev/null || true; }

print_selected_credentials() {
  echo "Generated credentials:"
  echo "  Dashboard password — use the saved login; reset offline if it is unavailable"
  for node in bitcoin monero litecoin dogecoin bitcoincash zcash; do
    upper=$(printf '%s' "$node" | tr '[:lower:]' '[:upper:]')
    [ "$(env_get "${upper}_ENABLED")" = 1 ] || continue
    label=$node
    case "$node" in
      bitcoin) label=Bitcoin ;;
      monero) label=Monero ;;
      litecoin) label=Litecoin ;;
      dogecoin) label=Dogecoin ;;
      bitcoincash) label="Bitcoin Cash" ;;
      zcash) label=Zcash ;;
    esac
    echo "  $label RPC — username: $(env_get "${upper}_RPC_USER")  password: $(env_get "${upper}_RPC_PASSWORD")"
  done
  if [ "$(env_get TARI_ENABLED)" = 1 ]; then
    echo "  Tari gRPC — no password; keep LAN exposure on a trusted network"
  fi
}


init() {
  umask 077
  for tool in jq openssl; do
    command -v "$tool" >/dev/null || {
      echo "$tool is required; install it with your host package manager."
      exit 1
    }
  done
  migrate_legacy_upgrade_agent

  if [ ! -f "$config_file" ]; then
    dashboard_password=$(openssl rand -hex 16)
    config_source=$(mktemp)
    if [ "$package_managed" = "0" ]; then
      jq -cn --arg password "$dashboard_password" '{bitcoin:{enabled:true},dashboard:{password:$password,bind_ip:"auto",launch_at_boot:false}}' >"$config_source"
    else
      jq -cn --arg password "$dashboard_password" '{bitcoin:{enabled:true,resource_profile:"compact",utxo_index:true},dashboard:{password:$password,bind_ip:"auto",launch_at_boot:false}}' >"$config_source"
    fi
    replace_config "$config_source"
    rm -f "$config_source"
    echo "Created a Bitcoin-only pruned configuration."
    echo "Dashboard — username: admin  password: $dashboard_password"
  else
    echo "Using the existing config.json."
  fi

  lock_config
  previous_env=$(mktemp "$state_dir/.env.before-init.XXXXXX")
  previous_approved_config=$(mktemp "$state_dir/.approved-config.before-init.XXXXXX")
  previous_approved_env=$(mktemp "$state_dir/.approved-env.before-init.XXXXXX")
  had_previous_env=0
  had_previous_approved_config=0
  had_previous_approved_env=0
  if [ -f "$env_file" ]; then cp "$env_file" "$previous_env"; had_previous_env=1; fi
  if [ -f "$approved_config_file" ]; then cp "$approved_config_file" "$previous_approved_config"; had_previous_approved_config=1; fi
  if [ -f "$approved_env_file" ]; then cp "$approved_env_file" "$previous_approved_env"; had_previous_approved_env=1; fi
  render_current_config
  if ! command -v docker >/dev/null 2>&1 || ! docker info >/dev/null 2>&1; then
    if [ "$had_previous_env" = 1 ]; then cp "$previous_env" "$env_file"; else rm -f "$env_file"; fi
    rm -f "$previous_env" "$previous_approved_config" "$previous_approved_env"
    unlock_config
    echo "Configuration was saved, but Docker is not ready. Start Docker, then run $stack_command init again." >&2
    return 1
  fi
  if ! guard_package_containers || { ! images_available && ! pull_images --policy missing; }; then
    if [ "$had_previous_env" = 1 ]; then cp "$previous_env" "$env_file"; else rm -f "$env_file"; fi
    rm -f "$previous_env" "$previous_approved_config" "$previous_approved_env"
    unlock_config
    echo "Initialization did not start; the previous runtime settings remain selected." >&2
    return 1
  fi
  if ! offline_up; then
    rollback_failed=0
    if [ "$had_previous_env" = 1 ]; then
      cp "$previous_env" "$env_file"
      offline_up >/dev/null 2>&1 || rollback_failed=1
    else
      compose down >/dev/null 2>&1 || rollback_failed=1
      rm -f "$env_file"
    fi
    rm -f "$previous_env" "$previous_approved_config" "$previous_approved_env"
    unlock_config
    [ "$rollback_failed" = 0 ] || echo "Initialization failed, and the previous runtime could not be fully restored." >&2
    echo "Initialization did not start; the previous runtime settings remain selected." >&2
    return 1
  fi
  if ! approve_current_config; then
    rollback_failed=0
    if [ "$had_previous_env" = 1 ]; then
      cp "$previous_env" "$env_file"
      offline_up >/dev/null 2>&1 || rollback_failed=1
    else
      compose down >/dev/null 2>&1 || rollback_failed=1
      rm -f "$env_file"
    fi
    if [ "$had_previous_approved_config" = 1 ]; then cp "$previous_approved_config" "$approved_config_file"; else rm -f "$approved_config_file"; fi
    if [ "$had_previous_approved_env" = 1 ]; then cp "$previous_approved_env" "$approved_env_file"; else rm -f "$approved_env_file"; fi
    rm -f "$previous_env" "$previous_approved_config" "$previous_approved_env"
    unlock_config
    [ "$rollback_failed" = 0 ] || echo "Initialization approval failed, and the previous runtime could not be fully restored." >&2
    echo "Initialization approval failed; the new runtime was not retained." >&2
    return 1
  fi
  rm -f "$previous_env" "$previous_approved_config" "$previous_approved_env"
  unlock_config
  ensure_resource_profile_timer
  ensure_port_control_timer
  ensure_node_control_timer
  ensure_host_stats_timer
  ensure_agent
  echo "Nodes: $(env_get COMPOSE_PROFILES)"
  dashboard_public_url=$(env_get DASHBOARD_PUBLIC_URL)
  if [ -n "$dashboard_public_url" ]; then
    echo "Started. Dashboard: $dashboard_public_url"
  else
    echo "Started. Dashboard: http://$(env_get DASHBOARD_BIND_IP):$(env_get DASHBOARD_PORT)/"
  fi
  print_selected_credentials
  echo "Edit config.json before init for custom first-boot settings, or use the dashboard after startup."
}

ensure_resource_profile_timer() {
  [ "$package_managed" = "1" ] || return 0
  unit='node-manager-resource-profile.timer'
  if [ "$(env_get BITCOIN_RESOURCE_PROFILE)" = compact ] || [ "$(env_get MONERO_RESOURCE_PROFILE)" = compact ] ||
    [ "$(env_get TARI_RESOURCE_PROFILE)" = compact ] || [ "$(env_get LITECOIN_RESOURCE_PROFILE)" = compact ] ||
    [ "$(env_get DOGECOIN_RESOURCE_PROFILE)" = compact ] || [ "$(env_get BITCOINCASH_RESOURCE_PROFILE)" = compact ] ||
    [ "$(env_get ZCASH_RESOURCE_PROFILE)" = compact ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable --now "$unit" >/dev/null 2>&1 ||
      echo "WARN  could not enable automatic post-sync resource limits; run: sudo systemctl enable --now $unit"
  else
    systemctl disable --now "$unit" >/dev/null 2>&1 || true
  fi
}

watch_dashboard_requests() {
  local unit=$1 mountpoint dropin=${BITCOIN_STACK_SYSTEMD_DIR:-/etc/systemd/system}/$1.path.d/volume.conf name
  shift
  mountpoint=$(docker volume inspect --format '{{.Mountpoint}}' "${project_name}_dashboard_state" 2>/dev/null) || return 0
  case "$mountpoint" in
    '') ;;
    /var/lib/docker/volumes/node-manager-apt_dashboard_state/_data | /var/lib/docker/volumes/bitcoin-starter-stack-apt_dashboard_state/_data)
      rm -f "$dropin" ;;
    *)
      { mkdir -p "${dropin%/*}" && { echo '[Path]'; for name; do echo "PathChanged=$mountpoint/$name.request"; done; } >"$dropin"; } 2>/dev/null ||
        echo "WARN  could not watch $mountpoint for dashboard requests; saves wait for the once-a-minute run" ;;
  esac
}

ensure_port_control_timer() {
  [ "$package_managed" = "1" ] || return 0
  watch_dashboard_requests node-manager-port-control port-control credential-control
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl enable --now node-manager-port-control.timer node-manager-port-control.path >/dev/null 2>&1 ||
    echo "WARN  could not enable LAN port controls; run: sudo systemctl enable --now node-manager-port-control.timer node-manager-port-control.path"
}

ensure_node_control_timer() {
  [ "$package_managed" = "1" ] || return 0
  watch_dashboard_requests node-manager-node-control node-control
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl enable --now node-manager-node-control.timer node-manager-node-control.path >/dev/null 2>&1 ||
    echo "WARN  could not enable node controls; run: sudo systemctl enable --now node-manager-node-control.timer node-manager-node-control.path"
}

ensure_host_stats_timer() {
  [ "$package_managed" = "1" ] || return 0
  [ -x "${BITCOIN_STACK_HOSTD:-$stack_root/hostd}" ] || return 0
  systemctl enable --now node-manager-host-stats.timer >/dev/null 2>&1 ||
    echo "WARN  could not enable host readings; run: sudo systemctl enable --now node-manager-host-stats.timer"
}

sync_node_runtime() {
  local dashboard_id
  dashboard_id=$(container_id dashboard)
  [ -n "$dashboard_id" ] || return 0
  [ "$(docker inspect --format '{{.State.Running}}' "$dashboard_id" 2>/dev/null || true)" = true ] || return 0
  local runtime='{}' node prefix enabled active
  for node in bitcoin monero tari litecoin dogecoin bitcoincash zcash; do
    prefix=$(printf '%s' "$node" | tr '[:lower:]' '[:upper:]')
    enabled=$(env_get "${prefix}_ENABLED")
    [ "$enabled" = 1 ] || continue
    active=$(env_get "${prefix}_ACTIVE")
    [ "$active" != 0 ] && active=true || active=false
    runtime=$(jq -c --arg node "$node" --argjson active "$active" '. + {($node):$active}' <<<"$runtime")
  done
  for _ in 1 2 3 4 5; do
    if printf '%s\n' "$runtime" | compose exec -T -u 1000 dashboard sh -c \
      'umask 077; cat > /state/.node-runtime.json.tmp; mv /state/.node-runtime.json.tmp /state/node-runtime.json' >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.2
  done
  return 1
}

prepare_linuxbrew_data_dirs() {
  [ "$package_managed" = brew ] && [ "$(uname -s)" = Linux ] || return 0
  local data_root=${BITCOIN_STACK_DATA_DIR:-} root_real node upper dir dir_real owner mode contents expected_owner expected_mode
  local tor_image commands='' mounts=()
  if [ -z "$data_root" ] || [ ! -d "$data_root" ] || [ -L "$data_root" ]; then
    echo "Linuxbrew data directory is missing or is a symbolic link: $data_root" >&2
    return 1
  fi
  root_real=$(readlink -f -- "$data_root") || return 1
  [ "$root_real" = "$data_root" ] || {
    echo "Linuxbrew data directory must use its canonical path: $root_real" >&2
    return 1
  }
  case "$data_root" in *:* | *,* | *$'\n'*) echo "Linuxbrew data directory contains unsupported characters." >&2; return 1 ;; esac

  for node in bitcoin monero tari litecoin dogecoin bitcoincash zcash; do
    upper=$(printf '%s' "$node" | tr '[:lower:]' '[:upper:]')
    dir=$(env_get "${upper}_DATA_DIR")
    expected_owner=1000:1000
    expected_mode=700
    if [ "$node" = zcash ]; then
      expected_owner=10001:1000
      expected_mode=750
    fi
    if [ "$dir" != "$data_root/$node" ]; then
      if [ ! -d "$dir" ] || [ -L "$dir" ] ||
        [ "$(stat -c '%u:%g' "$dir" 2>/dev/null)" != "$expected_owner" ] ||
        [ "$(stat -c '%a' "$dir" 2>/dev/null)" != "$expected_mode" ]; then
        echo "Custom $node data needs owner $expected_owner and mode $expected_mode: $dir" >&2
        printf 'Prepare it explicitly, then retry: sudo chown -R %s %q; sudo chmod %s %q\n' "$expected_owner" "$dir" "$expected_mode" "$dir" >&2
        return 1
      fi
      continue
    fi
    if [ ! -d "$dir" ] || [ -L "$dir" ]; then
      echo "Default $node data directory is missing or is a symbolic link: $dir" >&2
      return 1
    fi
    dir_real=$(readlink -f -- "$dir") || return 1
    [ "$dir_real" = "$root_real/$node" ] || {
      echo "Default $node data directory escapes the managed data root." >&2
      return 1
    }
    owner=$(stat -c '%u:%g' "$dir") || return 1
    mode=$(stat -c '%a' "$dir") || return 1
    [ "$owner" = "$expected_owner" ] && [ "$mode" = "$expected_mode" ] && continue
    contents=$(find "$dir" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null) || {
      echo "Linuxbrew cannot inspect $node data ownership: $dir" >&2
      return 1
    }
    if [ -n "$contents" ]; then
      echo "Linuxbrew will not change ownership or permissions of non-empty $node data: $dir" >&2
      printf 'Migrate it explicitly, then retry: sudo chown -R %s %q; sudo chmod %s %q\n' "$expected_owner" "$dir" "$expected_mode" "$dir" >&2
      return 1
    fi
    mounts+=( --mount "type=bind,src=$dir,dst=/node-data/$node" )
    commands+="chown $expected_owner /node-data/$node && chmod $expected_mode /node-data/$node && "
  done
  [ "${#mounts[@]}" -gt 0 ] || return 0
  tor_image=$(compose config --format json | jq -er '.services.tor.image') || return 1
  docker image inspect "$tor_image" >/dev/null 2>&1 || {
    echo "The local Tor image is required before Linuxbrew can prepare node data; run: $stack_command pull" >&2
    return 1
  }
  docker run --rm --network none --read-only --security-opt no-new-privileges \
    --cap-drop ALL --cap-add CHOWN --cap-add DAC_READ_SEARCH --cap-add FOWNER \
    --user 0:0 --entrypoint /bin/sh "${mounts[@]}" "$tor_image" -eu -c "${commands% && }" >/dev/null || {
    echo "Linuxbrew could not prepare the default node data directories." >&2
    return 1
  }
}

offline_up() {
  guard_package_containers || return 1
  local recreate=0
  [ "${1:-}" != --force-recreate ] || { recreate=1; shift; }
  for arg in "$@"; do
    case "$arg" in
      tor | bitcoin | monero | monero-wallet | tari | tari-wallet | litecoin | dogecoin | bitcoincash | zcash | dashboard) ;;
      *) echo "up accepts service names only; image downloads are separate: $stack_command pull."; return 1 ;;
    esac
  done
  images_available || {
    echo "Start failed. Missing images? Run $stack_command pull, then retry."
    return 1
  }
  prepare_linuxbrew_data_dirs || return 1
  [ "$recreate" = 0 ] || set -- --force-recreate --no-deps "$@"
  compose up -d --pull never --no-build "$@" || {
    echo "Start failed. Missing images? Run $stack_command pull, then retry."
    return 1
  }
  sync_node_runtime || {
    echo "Start succeeded, but the dashboard node state could not be synchronized."
    return 1
  }
}

pull_images() {
  compose pull "$@"
}

pull_package_images() {
  local service attempt started
  for service in "$@"; do
    for attempt in 1 2 3; do
      started=$SECONDS
      if BITCOIN_STACK_COMPOSE_TIMEOUT_SECONDS=600 pull_images "$service"; then
        echo "Pulled the $service image in $((SECONDS - started)) s (attempt $attempt of 3)."
        continue 2
      fi
      echo "Pulling the $service image failed after $((SECONDS - started)) s (attempt $attempt of 3)." >&2
      [ "$attempt" = 3 ] || sleep $((attempt * 15))
    done
    return 1
  done
}

running_package_services() {
  local service id running
  for service in tor bitcoin monero monero-wallet tari tari-wallet litecoin dogecoin bitcoincash zcash dashboard; do
    if ! id=$(container_id "$service"); then
      echo "Running $service container state could not be queried." >&2
      return 1
    fi
    [ -n "$id" ] || continue
    if ! running=$(docker inspect --format '{{.State.Running}}' "$id" 2>/dev/null); then
      echo "Running $service container state could not be inspected." >&2
      return 1
    fi
    case "$running" in
      true) printf '%s\n' "$service" ;;
      false) ;;
      *) echo "Running $service container returned an invalid state." >&2; return 1 ;;
    esac
  done
}

render_package_upgrade_env() {
  local version target
  version=$(cat "$stack_root/VERSION") || return 1
  case "$version" in
    '' | [!0-9]* | *[!A-Za-z0-9.-]* | *[.-]) echo "Installed package version is invalid." >&2; return 1 ;;
  esac
  [ "${#version}" -le 128 ] || { echo "Installed package version is invalid." >&2; return 1; }
  target=$(mktemp "$state_dir/.env.package-upgrade.XXXXXX") || return 1
  if ! awk -v version="$version" '
    /^STACK_VERSION=/ { print "STACK_VERSION=" version; found++; next }
    { print }
    END { if (found != 1) exit 1 }
  ' "$approved_env_file" >"$target"; then
    rm -f "$target"
    echo "Approved runtime is missing a single package version field." >&2
    return 1
  fi
  if ! grep -q '^TOR_ONION_NODES=' "$target" && ! add_package_upgrade_tor_keys "$target"; then
    rm -f "$target"
    echo "Could not derive the Tor network settings from the approved configuration." >&2
    return 1
  fi
  chmod 600 "$target"
  mv "$target" "$env_file"
}

# An approved runtime from before 1.35 lacks these keys; derive them as configure.sh does.
add_package_upgrade_tor_keys() {
  local target=$1 clearnet inbound profiles nodes='' node
  clearnet=$(jq -r 'if .network.clearnet_over_tor == false then 0 else 1 end' "$approved_config_file") || return 1
  inbound=$(jq -r 'if .network.inbound_connections == false then 0 else 1 end' "$approved_config_file") || return 1
  profiles=$(sed -n 's/^COMPOSE_PROFILES=//p' "$target")
  if [ "$inbound" = 1 ]; then
    for node in bitcoin litecoin bitcoincash; do
      case ",$profiles," in *",$node,"*) nodes=${nodes:+$nodes,}$node ;; esac
    done
  fi
  grep -q '^TOR_CLEARNET=' "$target" || printf 'TOR_CLEARNET=%s\n' "$clearnet" >>"$target"
  grep -q '^TOR_INBOUND=' "$target" || printf 'TOR_INBOUND=%s\n' "$inbound" >>"$target"
  printf 'TOR_ONION_NODES=%s\n' "$nodes" >>"$target"
}

restore_package_upgrade_state() {
  cp "$1" "$env_file"
  cp "$2" "$approved_config_file"
  cp "$3" "$approved_env_file"
  chmod 600 "$env_file" "$approved_config_file" "$approved_env_file"
}

mark_package_upgrade_pending() {
  touch "$state_dir/.package-upgrade-pending"
  chmod 600 "$state_dir/.package-upgrade-pending"
}

package_upgrade() {
  local service current package_upgrade_failed running_output
  local previous_env previous_approved_config previous_approved_env
  local -a running_before running_now upgrade_services
  case "$package_managed" in 1 | apt) ;; *) echo "package-upgrade is available only to the APT package." >&2; return 1 ;; esac
  [ -s "$env_file" ] && [ -s "$approved_config_file" ] && [ -s "$approved_env_file" ] || return 0
  if ! command -v docker >/dev/null 2>&1 || ! docker info >/dev/null 2>&1; then
    echo "Docker is not ready; the package is installed but its containers were not updated." >&2
    mark_package_upgrade_pending
    return 1
  fi

  lock_config
  guard_package_containers || { mark_package_upgrade_pending; unlock_config; return 1; }
  if ! running_output=$(running_package_services); then
    mark_package_upgrade_pending
    unlock_config
    return 1
  fi
  running_before=()
  [ -z "$running_output" ] || mapfile -t running_before <<<"$running_output"
  if [ "${#running_before[@]}" = 0 ]; then
    rm -f "$state_dir/.package-upgrade-pending"
    unlock_config
    return 0
  fi

  previous_env=$(mktemp "$state_dir/.env.before-package-upgrade.XXXXXX")
  previous_approved_config=$(mktemp "$state_dir/.approved-config.before-package-upgrade.XXXXXX")
  previous_approved_env=$(mktemp "$state_dir/.approved-env.before-package-upgrade.XXXXXX")
  cp "$env_file" "$previous_env"
  cp "$approved_config_file" "$previous_approved_config"
  cp "$approved_env_file" "$previous_approved_env"
  chmod 600 "$previous_env" "$previous_approved_config" "$previous_approved_env"

  package_upgrade_failed=0
  if ! render_package_upgrade_env; then
    package_upgrade_failed=1
  elif ! pull_package_images "${running_before[@]}"; then
    package_upgrade_failed=1
  fi
  if [ "$package_upgrade_failed" = 1 ]; then
    restore_package_upgrade_state "$previous_env" "$previous_approved_config" "$previous_approved_env"
    rm -f "$previous_env" "$previous_approved_config" "$previous_approved_env"
    mark_package_upgrade_pending
    unlock_config
    echo "Container activation failed before any running service was changed." >&2
    return 1
  fi

  guard_package_containers || {
    restore_package_upgrade_state "$previous_env" "$previous_approved_config" "$previous_approved_env"
    rm -f "$previous_env" "$previous_approved_config" "$previous_approved_env"
    mark_package_upgrade_pending
    unlock_config
    return 1
  }
  if ! running_output=$(running_package_services); then
    restore_package_upgrade_state "$previous_env" "$previous_approved_config" "$previous_approved_env"
    rm -f "$previous_env" "$previous_approved_config" "$previous_approved_env"
    mark_package_upgrade_pending
    unlock_config
    return 1
  fi
  running_now=()
  [ -z "$running_output" ] || mapfile -t running_now <<<"$running_output"
  upgrade_services=()
  for service in "${running_before[@]}"; do
    for current in "${running_now[@]}"; do
      if [ "$service" = "$current" ]; then upgrade_services+=("$service"); break; fi
    done
  done
  if [ "${#upgrade_services[@]}" = 0 ]; then
    if ! approve_current_config "$approved_config_file"; then
      restore_package_upgrade_state "$previous_env" "$previous_approved_config" "$previous_approved_env"
      rm -f "$previous_env" "$previous_approved_config" "$previous_approved_env"
      mark_package_upgrade_pending
      unlock_config
      return 1
    fi
    rm -f "$previous_env" "$previous_approved_config" "$previous_approved_env" "$state_dir/.package-upgrade-pending"
    unlock_config
    ensure_resource_profile_timer
    ensure_port_control_timer
    ensure_node_control_timer
    ensure_host_stats_timer
    return 0
  fi

  if ! approve_current_config "$approved_config_file"; then
    restore_package_upgrade_state "$previous_env" "$previous_approved_config" "$previous_approved_env"
    rm -f "$previous_env" "$previous_approved_config" "$previous_approved_env"
    mark_package_upgrade_pending
    unlock_config
    return 1
  fi

  if ! compose up -d --pull never --no-build --no-deps "${upgrade_services[@]}"; then
    rm -f "$previous_env" "$previous_approved_config" "$previous_approved_env"
    mark_package_upgrade_pending
    unlock_config
    echo "The new containers could not be fully activated; no automatic image downgrade was attempted." >&2
    echo "Check the current state with: sudo node-manager status" >&2
    echo "Restart the services interrupted by activation with: sudo node-manager up ${upgrade_services[*]}" >&2
    echo "Retry activation with: sudo node-manager package-upgrade" >&2
    return 1
  fi
  sync_node_runtime || echo "WARN  containers were updated, but dashboard node state will synchronize on its next refresh." >&2
  previous_version=$(sed -n 's/^STACK_VERSION=//p' "$previous_approved_env" 2>/dev/null | tail -n 1)
  current_version=$(sed -n 's/^STACK_VERSION=//p' "$approved_env_file" 2>/dev/null | tail -n 1)
  cleanup_superseded_runtime "$current_version" "$previous_version" || true
  rm -f "$previous_env" "$previous_approved_config" "$previous_approved_env" "$state_dir/.package-upgrade-pending"
  unlock_config
  ensure_resource_profile_timer
  ensure_port_control_timer
  ensure_node_control_timer
  ensure_host_stats_timer
  echo "Updated the running Node Manager services."
}

cleanup_superseded_runtime() {
  local keep_current=$1 keep_previous=$2 line image id repo tag
  docker images --format '{{.Repository}}:{{.Tag}} {{.ID}}' 2>/dev/null | while IFS= read -r line; do
    image=${line% *}
    id=${line##* }
    repo=${image%:*}
    tag=${image##*:}
    case "$repo" in
      ghcr.io/vijitsingh97/node-manager-* | ghcr.io/vijitsingh97/bitcoin-starter-stack-* | bitcoin-starter-stack-*) ;;
      *) continue ;;
    esac
    if [ "$tag" = "<none>" ]; then
      docker rmi "$id" >/dev/null 2>&1 || true
      continue
    fi
    [ "$tag" != "$keep_current" ] || continue
    [ -z "$keep_previous" ] || [ "$tag" != "$keep_previous" ] || continue
    docker rmi "$image" >/dev/null 2>&1 || true
  done
  docker volume prune -f >/dev/null 2>&1 || true
}

images_available() {
  local images image
  images=$(compose config --images) || return 1
  while IFS= read -r image; do
    [ -z "$image" ] || docker image inspect "$image" >/dev/null 2>&1 || return 1
  done <<<"$images"
}

status() {
  compose ps
  bad=0
  services="tor dashboard"
  [ "$(env_get BITCOIN_ENABLED)" != "0" ] && [ "$(env_get BITCOIN_ACTIVE)" != "0" ] && services="$services bitcoin"
  [ "$(env_get MONERO_ENABLED)" = "1" ] && [ "$(env_get MONERO_ACTIVE)" != "0" ] && services="$services monero monero-wallet"
  for node in TARI LITECOIN DOGECOIN BITCOINCASH ZCASH; do
    [ "$(env_get "${node}_ENABLED")" = 1 ] && [ "$(env_get "${node}_ACTIVE")" != 0 ] && services="$services $(printf '%s' "$node" | tr '[:upper:]' '[:lower:]')"
  done
  for svc in $services; do
    id=$(container_id "$svc")
    if [ -n "$id" ]; then
      st=$(docker inspect "$id" --format '{{.State.Status}} {{if .State.Health}}{{.State.Health.Status}}{{end}}' 2>/dev/null || echo missing)
    else
      st=missing
    fi
    case "$st" in
      "running healthy") echo "OK    $svc" ;;
      "running health: starting" | "running starting") echo "WAIT  $svc (health check warming up)" ;;
      *)
        echo "WARN  $svc: $st"
        bad=1
        ;;
    esac
  done
  return "$bad"
}

host_has_ipv4() {
  local addresses
  case "$(uname -s)" in
    Darwin) addresses=$("${IFCONFIG_BIN:-/sbin/ifconfig}" -a 2>/dev/null) ;;
    *) addresses=$("${IP_BIN:-ip}" -o -4 addr show 2>/dev/null) ;;
  esac || return 0
  grep -Fq -e "inet $1/" -e "inet $1 " <<<"$addresses"
}

doctor() {
  echo "== Dependencies"
  for tool in docker jq openssl; do
    if command -v "$tool" >/dev/null; then echo "OK    $tool"; else echo "MISS  $tool"; fi
  done

  echo "== Config"
  [ ! -e "$state_dir/.package-upgrade-pending" ] ||
    echo "WARN  Node Manager $(cat "$stack_root/VERSION" 2>/dev/null) is installed, but its containers were not updated; retry with: sudo node-manager package-upgrade"
  if [ ! -f "$config_file" ]; then
    echo "MISS  config.json ($config_file)"
  elif [ ! -f "$env_file" ]; then
    echo "MISS  .env (run $stack_command apply)"
  elif [ "$config_file" -nt "$env_file" ]; then
    echo "WARN  config.json is newer than .env — run $stack_command apply"
  else
    echo "OK    config.json rendered into .env"
  fi
  for listener in DASHBOARD BITCOIN_RPC MONERO_RPC MONERO_ZMQ TARI_GRPC LITECOIN_RPC DOGECOIN_RPC BITCOINCASH_RPC ZCASH_RPC; do
    [ "$listener" = DASHBOARD ] || [ "$(env_get "${listener}_EXPOSE")" = 1 ] || continue
    address=$(env_get "${listener}_BIND_IP")
    case "$address" in '' | 127.* | ::1) continue ;; esac
    host_has_ipv4 "$address" ||
      echo "WARN  ${listener}_BIND_IP $address is not on this host; Tor cannot publish it until the address returns or config.json changes (an auto dashboard moves within a minute)"
  done
  [ ! -s "$state_dir/.paused-listeners" ] ||
    awk '{print "WARN  LAN listeners on " $1 " are paused until that address is back on this host; re-point them from Settings"}' "$state_dir/.paused-listeners"

  echo "== Leftovers"
  found_orphan=0
  for dir in "$state_dir/data"/*/; do
    [ -d "$dir" ] || continue
    dir=${dir%/}
    configured=0
    for node in BITCOIN MONERO TARI LITECOIN DOGECOIN BITCOINCASH ZCASH; do
      if [ "$(env_get "${node}_DATA_DIR")" = "$dir" ]; then
        configured=1
        break
      fi
    done
    [ "$configured" = 0 ] || continue
    kb=$(du -sk "$dir" 2>/dev/null | awk '{print $1}')
    [ -n "$kb" ] && [ "$kb" -ge 1024 ] || continue
    echo "WARN  orphaned data directory $dir ($((kb / 1024)) MiB) is not any node's configured data dir; remove it if its node's data moved"
    found_orphan=1
  done
  [ "$found_orphan" = 1 ] || echo "OK    no orphaned data directories"

  echo "== Disk"
  if [ "$(env_get BITCOIN_ENABLED)" != "0" ] && [ "$(env_get BITCOIN_ACTIVE)" != "0" ]; then
    data_dir=$(env_get BITCOIN_DATA_DIR)
    df -h "${data_dir:-.}" 2>/dev/null | tail -1 | awk '{printf "      Bitcoin: %s free of %s (%s used) at %s\n", $4, $2, $5, $6}'
  fi
  if [ "$(env_get MONERO_ENABLED)" = "1" ] && [ "$(env_get MONERO_ACTIVE)" != "0" ]; then
    data_dir=$(env_get MONERO_DATA_DIR)
    df -h "${data_dir:-.}" 2>/dev/null | tail -1 | awk '{printf "      Monero: %s free of %s (%s used) at %s\n", $4, $2, $5, $6}'
  fi
  for node in TARI LITECOIN DOGECOIN BITCOINCASH ZCASH; do
    [ "$(env_get "${node}_ENABLED")" = 1 ] || continue
    data_dir=$(env_get "${node}_DATA_DIR")
    label=$(printf '%s' "$node" | tr '[:upper:]' '[:lower:]')
    df -h "${data_dir:-.}" 2>/dev/null | tail -1 | awk -v node="$label" '{printf "      %s: %s free of %s (%s used) at %s\n", node, $4, $2, $5, $6}'
  done

  echo "== Containers"
  status || true

  echo "== Nodes"
  if [ "$(env_get BITCOIN_ENABLED)" != "0" ]; then
    if compose exec -T bitcoin bitcoin-cli -datadir=/data getblockchaininfo 2>/dev/null |
      jq -r '"      Bitcoin: blocks \(.blocks)/\(.headers)  progress \((.verificationprogress*100*100|round)/100)%  ibd \(.initialblockdownload)  pruned \(.pruned)"'; then :; else
      echo "      Bitcoin RPC unreachable (normal during startup; if it persists, check $stack_command logs bitcoin)"
    fi
  fi
  if [ "$(env_get MONERO_ENABLED)" = "1" ]; then
    if compose exec -T monero /usr/local/bin/monero-healthcheck >/dev/null 2>&1; then
      echo "      Monero RPC reachable"
    else
      echo "      Monero RPC unreachable (normal during startup; if it persists, check $stack_command logs monero)"
    fi
  fi
  for node in tari litecoin dogecoin bitcoincash zcash; do
    upper=$(printf '%s' "$node" | tr '[:lower:]' '[:upper:]')
    [ "$(env_get "${upper}_ENABLED")" = 1 ] || continue
    [ "$(env_get "${upper}_ACTIVE")" != 0 ] || continue
    node_id=$(container_id "$node")
    if [ -n "$node_id" ] && docker inspect "$node_id" --format '{{.State.Status}} {{if .State.Health}}{{.State.Health.Status}}{{end}}' 2>/dev/null | grep -q '^running healthy$'; then
      echo "      $node RPC reachable"
    else
      echo "      $node unavailable (normal during startup; if it persists, check $stack_command logs $node)"
    fi
  done

  echo "== Tor"
  compose logs --no-color tor 2>&1 | grep "Bootstrapped" | tail -1 | sed 's/^/      /' || echo "      no bootstrap log yet"
  if [ "$(env_get DASHBOARD_ONION)" = "1" ]; then
    echo "      dashboard onion: $(compose exec -T tor cat /var/lib/tor/dashboard_onion/hostname 2>/dev/null || echo 'not provisioned yet')"
  fi
  if [ "$(env_get BITCOIN_ENABLED)" != "0" ] && [ "$(env_get TOR_INBOUND)" != "0" ]; then
    echo "      node onion: $(compose exec -T bitcoin bitcoin-cli -datadir=/data getnetworkinfo 2>/dev/null | jq -r '.localaddresses[0].address // "not registered yet"')"
  fi
}

do_backup() {
  umask 077
  mkdir -p "$state_dir/backups"
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  [ -f "$config_file" ] && cp "$config_file" "$tmp/config.json"
  [ -f "$env_file" ] && cp "$env_file" "$tmp/.env"
  # the dashboard and node onion keys live in the tor volume
  compose cp tor:/var/lib/tor/dashboard_onion "$tmp/dashboard_onion" >/dev/null 2>&1 ||
    echo "WARN: dashboard onion keys not captured (is the tor container up?)"
  for node in bitcoin litecoin bitcoincash; do
    compose cp "tor:/var/lib/tor/${node}_onion" "$tmp/${node}_onion" >/dev/null 2>&1 ||
      case ",$(env_get TOR_ONION_NODES)," in
      *",$node,"*) echo "WARN: $node onion keys not captured (is the tor container up?)" ;;
      esac
  done
  # UI-managed dashboard state is not otherwise re-derivable.
  compose cp dashboard:/state "$tmp/dashboard_state" >/dev/null 2>&1 ||
    echo "WARN: dashboard state not captured (is the dashboard container up?)"
  out="$state_dir/backups/stack-backup-$(date +%Y%m%d-%H%M%S).tar.gz"
  tar czf "$out" -C "$tmp" .
  chmod 600 "$out"
  echo "Wrote $out (config, credentials, onion keys, dashboard state — chain data excluded, it's re-derivable)"
}

do_restore() {
  umask 077
  yes=0
  if [ "${1:-}" = "-y" ]; then
    yes=1
    shift
  fi
  if [ -z "${1:-}" ]; then
    echo "usage: ./stack restore [-y] <archive>"
    exit 1
  fi
  archive=$1
  if [ "$yes" != "1" ]; then
    printf "This overwrites config.json, .env, and onion keys from %s. Continue? [y/N] " "$archive"
    read -r reply
    case "$reply" in y | Y) ;; *)
      echo "Aborted."
      exit 1
      ;;
    esac
  fi
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  tar xzf "$archive" -C "$tmp"
  if [ -f "$tmp/config.json" ]; then
    replace_config "$tmp/config.json"
    echo "Restored config.json"
  fi
  if [ -f "$tmp/.env" ]; then
    chmod 600 "$env_file" 2>/dev/null || true
    cp "$tmp/.env" "$env_file" && chmod 600 "$env_file" && echo "Restored .env"
  fi
  if [ -f "$tmp/onion_v3_private_key" ]; then
    echo "Skipped onion_v3_private_key: Tor now keeps the node onion keys"
  fi
  restored=
  for dir in dashboard_onion bitcoin_onion litecoin_onion bitcoincash_onion; do
    [ -d "$tmp/$dir" ] || continue
    if compose cp "$tmp/$dir" tor:/var/lib/tor/ >/dev/null 2>&1 &&
      compose exec -u root tor chown -R tor:tor "/var/lib/tor/$dir" >/dev/null 2>&1; then
      restored="$restored $dir"
    else
      echo "WARN: could not restore $dir keys (is the tor container up?)"
    fi
  done
  if [ -n "$restored" ]; then
    compose restart tor >/dev/null
    # Running nodes advertise the onion address they read at startup.
    for dir in $restored; do
      [ "$dir" = dashboard_onion ] || compose restart "${dir%_onion}" >/dev/null 2>&1 || true
    done
    echo "Restored onion keys:$restored (tor restarted)"
  fi
  if [ -d "$tmp/dashboard_state" ]; then
    # Extract as the dashboard user so private files keep the correct owner.
    if tar -cf - -C "$tmp/dashboard_state" . |
    compose exec -T -u 1000 dashboard tar -xof - -C /state; then
      echo "Restored dashboard state"
    else
      echo "ERROR: could not restore dashboard state (is the dashboard container up and writable by uid 1000?)"
      exit 1
    fi
  fi
  [ ! -f "$env_file" ] || approve_current_config
  echo "Done. Apply with: $stack_command apply"
}

do_upgrade() {
  cat <<EOF
Node Manager does not update itself. Install the new version with the method you originally used:

Back up first if you want a restore point:
  $stack_command backup

  Ubuntu / APT
    sudo apt update
    sudo apt install --only-upgrade node-manager

  macOS / Homebrew
    brew update
    brew upgrade node-manager
    $stack_command pull
    $stack_command apply

  GitHub release or source install
    https://github.com/VijitSingh97/node-manager/releases/latest
EOF
}

upgrade_agent() {
  echo "upgrade-agent is now host-service; application updates are manual."
  exec "$stack_root/stack" host-service
}

ensure_agent() {
  if [ "$package_managed" = brew ]; then
    command -v brew >/dev/null 2>&1 || {
      echo "Homebrew is required to start dashboard host controls." >&2
      return 1
    }
    brew services start node-manager >/dev/null || {
      echo "Homebrew could not start dashboard host controls." >&2
      return 1
    }
    echo "Host controls and automatic post-sync caps are running through Homebrew."
    return 0
  fi
  [ "$package_managed" = "1" ] && return 0
  if [ "$(uname -s)" != Darwin ] && {
    systemctl is-enabled bitcoin-stack-host-service >/dev/null 2>&1 ||
      systemctl is-enabled bitcoin-stack-upgrade-agent >/dev/null 2>&1
  }; then
    return 0
  fi
  exec 9>"$state_dir/.host-service.lock"
  if flock -n 9; then
    flock -u 9
    host_log=$state_dir/host-service.log
    touch "$host_log"
    chmod 600 "$host_log"
    nohup env BITCOIN_STACK_ROOT="$stack_root" BITCOIN_STACK_STATE_DIR="$state_dir" BITCOIN_STACK_CONFIG_DIR="$config_dir" \
      "$stack_root/stack" host-service >>"$host_log" 2>&1 </dev/null &
    echo $! >"$state_dir/.host-service.pid"
    echo "host-service: started for this login session (log: $host_log)"
  else
    echo "host-service: already running"
  fi
  [ "$(uname -s)" = Darwin ] && return 0
  printf -v quoted_root '%q' "$stack_root"
  printf -v quoted_state '%q' "$state_dir"
  line="@reboot sleep 60 && cd $quoted_root && ./stack host-service >> $quoted_state/host-service.log 2>&1"
  existing_cron=$(crontab -l 2>/dev/null || true)
  { printf '%s\n' "$existing_cron" |
      grep -vF "cd $stack_root && ./stack upgrade-agent" |
      grep -vF "cd $quoted_root && ./stack upgrade-agent" |
      grep -vF "cd $quoted_root && ./stack host-service" || true; echo "$line"; } | crontab - 2>/dev/null ||
    echo "WARN  could not install the host-service @reboot cron entry"
}

legacy_upgrade_agent_matches() {
  local process=$1 canonical_root=$2 process_cwd argument candidate candidate_dir index
  local -a arguments=()
  [ -r "$process/cmdline" ] || return 1
  process_cwd=$(readlink "$process/cwd" 2>/dev/null || true)
  [ -n "$process_cwd" ] && process_cwd=$(cd "$process_cwd" 2>/dev/null && pwd -P || true)
  [ "$process_cwd" = "$canonical_root" ] || return 1
  while IFS= read -r -d '' argument; do arguments+=("$argument"); done <"$process/cmdline"
  for ((index = 0; index + 1 < ${#arguments[@]}; index++)); do
    [ "${arguments[index + 1]}" = upgrade-agent ] || continue
    case "${arguments[index]}" in
      /*) candidate=${arguments[index]} ;;
      *) candidate=$process_cwd/${arguments[index]} ;;
    esac
    candidate_dir=$(cd "${candidate%/*}" 2>/dev/null && pwd -P) || continue
    [ "$candidate_dir/${candidate##*/}" = "$canonical_root/stack" ] && return 0
  done
  return 1
}

migrate_legacy_upgrade_agent() {
  [ "$package_managed" = "0" ] || return 0
  [ "$(uname -s)" = Linux ] || return 0
  local proc_root=${BITCOIN_STACK_PROC_ROOT:-/proc} canonical_root process pid attempt failed=0
  local -a legacy_pids=()
  canonical_root=$(cd "$stack_root" && pwd -P)
  for process in "$proc_root"/[0-9]*; do
    pid=${process##*/}
    [ "$pid" != "$$" ] || continue
    legacy_upgrade_agent_matches "$process" "$canonical_root" || continue
    if ! kill -TERM "$pid" 2>/dev/null; then
      if legacy_upgrade_agent_matches "$process" "$canonical_root"; then
        echo "WARN  could not stop legacy upgrade-agent process $pid for this installation." >&2
        failed=1
      fi
      continue
    fi
    legacy_pids+=("$pid")
  done
  for pid in "${legacy_pids[@]}"; do
    for ((attempt = 0; attempt < 20; attempt++)); do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.1
    done
    if kill -0 "$pid" 2>/dev/null && legacy_upgrade_agent_matches "$proc_root/$pid" "$canonical_root"; then
      kill -KILL "$pid" 2>/dev/null || true
      sleep 0.1
    fi
    if kill -0 "$pid" 2>/dev/null && legacy_upgrade_agent_matches "$proc_root/$pid" "$canonical_root"; then
      echo "WARN  could not stop legacy upgrade-agent process $pid for this installation." >&2
      failed=1
    fi
  done
  return "$failed"
}

host_service() {
  umask 077
  exec 7>"$state_dir/.host-service.lock"
  flock -n 7 || { echo "Another host service is already running." >&2; return 1; }
  trap 'exit 0' TERM INT
  local started=0 ticks=0 helper
  echo "host-service: waiting for saved configuration and Docker."
  while true; do
    if { [ -r "$config_file" ] || { [ -r "$approved_config_file" ] && [ -r "$approved_env_file" ]; }; } &&
      docker info >/dev/null 2>&1; then
      if [ "$started" = 0 ]; then
        lock_config
        prepare_config_for_start
        unlock_config
        if [ "$(env_get STACK_RESTART_POLICY)" != unless-stopped ]; then
          started=1
          echo "host-service: launch at login is off; supervising controls only."
        elif (lock_config; offline_up || exit 1; unlock_config); then
          started=1
          echo "host-service: supervising node controls and post-sync limits."
        fi
      fi
      if [ "$started" = 1 ]; then
        guard_package_containers || return 1
        for helper in node-control node-port-control; do
          BITCOIN_STACK_ROOT="$stack_root" BITCOIN_STACK_STATE_DIR="$state_dir" BITCOIN_STACK_CONFIG_DIR="$config_dir" \
            "$stack_root/scripts/$helper" || echo "host-service: $helper check failed; will retry."
        done
        if [ "$ticks" = 0 ]; then
          BITCOIN_STACK_ROOT="$stack_root" BITCOIN_STACK_STATE_DIR="$state_dir" \
            "$stack_root/scripts/node-resource-profile" || echo "host-service: resource check failed; will retry."
        fi
        ticks=$(((ticks + 1) % 6))
      fi
    fi
    sleep 10 7>&- &
    wait $! || true
  done
}

cmd=${1:-help}
[ $# -gt 0 ] && shift

case "$cmd" in
  up)
    migrate_legacy_upgrade_agent
    lock_config
    prepare_config_for_start
    offline_up "$@"
    unlock_config
    ensure_resource_profile_timer
    ensure_port_control_timer
    ensure_node_control_timer
    ensure_host_stats_timer
    ensure_agent
    ;;
  init) init ;;
  down) guard_package_containers && utxo_unpark_dump "$@" && compose down "$@" ;;
  stop) guard_package_containers && utxo_unpark_dump "$@" && compose stop "$@" ;;
  restart)
    lock_config
    prepare_config_for_start
    utxo_unpark_dump "$@"
    if [ "$config_was_applied" = 1 ]; then
      offline_up "$@"
    else
      guard_package_containers && compose restart "$@"
    fi
    unlock_config
    ;;
  logs) guard_package_containers && compose logs -f --tail=100 "$@" ;;
  events) guard_package_containers && compose exec -T dashboard sh -c 'cat /state/events.log 2>/dev/null || echo "no events yet"' ;;
  apply)
    migrate_legacy_upgrade_agent
    lock_config
    previous_env=$(mktemp "$state_dir/.env.before-apply.XXXXXX")
    previous_approved_config=$(mktemp "$state_dir/.approved-config.before-apply.XXXXXX")
    previous_approved_env=$(mktemp "$state_dir/.approved-env.before-apply.XXXXXX")
    had_previous_env=0
    had_previous_approved_config=0
    had_previous_approved_env=0
    if [ -f "$env_file" ]; then
      cp "$env_file" "$previous_env"
      had_previous_env=1
    fi
    if [ -f "$approved_config_file" ]; then cp "$approved_config_file" "$previous_approved_config"; had_previous_approved_config=1; fi
    if [ -f "$approved_env_file" ]; then cp "$approved_env_file" "$previous_approved_env"; had_previous_approved_env=1; fi
    apply_failed=0
    runtime_attempted=0
    if render_current_config; then
      runtime_attempted=1
      if ! offline_up || ! approve_current_config; then
        apply_failed=1
      fi
    else
      apply_failed=1
    fi
    if [ "$apply_failed" = 1 ]; then
      rollback_failed=0
      if [ "$had_previous_env" = 1 ]; then
        cp "$previous_env" "$env_file"
        if [ "$runtime_attempted" = 1 ]; then
          offline_up >/dev/null 2>&1 || rollback_failed=1
        fi
      else
        if [ "$runtime_attempted" = 1 ]; then
          compose down >/dev/null 2>&1 || rollback_failed=1
        fi
        rm -f "$env_file"
      fi
      if [ "$had_previous_approved_config" = 1 ]; then cp "$previous_approved_config" "$approved_config_file"; else rm -f "$approved_config_file"; fi
      if [ "$had_previous_approved_env" = 1 ]; then cp "$previous_approved_env" "$approved_env_file"; else rm -f "$approved_env_file"; fi
      rm -f "$previous_env" "$previous_approved_config" "$previous_approved_env"
      unlock_config
      [ "$rollback_failed" = 0 ] || echo "New configuration failed, and the previous runtime could not be fully restored." >&2
      echo "New configuration was not approved; the previous runtime settings remain selected." >&2
      exit 1
    fi
    rm -f "$previous_env" "$previous_approved_config" "$previous_approved_env"
    unlock_config
    ensure_resource_profile_timer
    ensure_port_control_timer
    ensure_node_control_timer
    ensure_host_stats_timer
    ensure_agent
    ;;
  approve-rendered-config)
    [ "${BITCOIN_STACK_CONFIG_LOCK_HELD:-0}" = 1 ] || {
      echo "approve-rendered-config requires the configuration lock." >&2
      exit 1
    }
    approve_current_config
    ;;
  apply-port-settings)
    lock_config
    "$stack_root/configure.sh"
    guard_package_containers
    compose up -d --pull never --no-build --no-deps tor dashboard || {
      echo "Port settings could not be applied with the installed images."
      exit 1
    }
    approve_current_config
    unlock_config
    ;;
  apply-credential-settings)
    node=${1:-}
    case "$node" in
      bitcoin) services=(bitcoin dashboard) ;;
      monero) services=(monero monero-wallet dashboard) ;;
      litecoin | dogecoin | bitcoincash) services=("$node" dashboard) ;;
      zcash) services=(dashboard) ;;
      *) echo "Unsupported credential target: $node" >&2; exit 1 ;;
    esac
    lock_config
    [ "$(jq -r --arg node "$node" 'if .[$node] | has("active") then .[$node].active == true else true end' "$config_file")" = true ] || {
      echo "Cannot apply credentials for an inactive node." >&2
      exit 1
    }
    credential_limits=${BITCOIN_STACK_CREDENTIAL_LIMITS:-}
    if [ "$node" != zcash ] && [ -z "$credential_limits" ]; then
      node_id=$(container_id "$node")
      [ -n "$node_id" ] || {
        echo "Current node container could not be found." >&2
        exit 1
      }
      credential_limits=$(docker inspect --format '{{.HostConfig.NanoCpus}} {{.HostConfig.Memory}} {{.HostConfig.MemorySwap}}' "$node_id")
    fi
    if [ "$node" != zcash ] && [[ ! "$credential_limits" =~ ^[0-9]+\ [0-9]+\ -?[0-9]+$ ]]; then
      echo "Current node resource limits could not be preserved." >&2
      exit 1
    fi
    "$stack_root/configure.sh"
    guard_package_containers
    compose up -d --pull never --no-build --no-deps "${services[@]}" || {
      echo "RPC credentials could not be applied with the installed images."
      exit 1
    }
    if [ "$node" != zcash ]; then
      read -r nano_cpus memory_bytes memory_swap <<<"$credential_limits"
      update_args=()
      [ "$nano_cpus" = 0 ] || update_args+=(--cpus "$(awk -v value="$nano_cpus" 'BEGIN { printf "%.9f", value / 1000000000 }')")
      if [ "$memory_bytes" != 0 ]; then
        update_args+=(--memory "$memory_bytes" --memory-swap "$memory_swap")
      elif [ "$memory_swap" != 0 ]; then
        echo "Current node resource limits are inconsistent." >&2
        exit 1
      fi
      [ "${#update_args[@]}" = 0 ] || docker update "${update_args[@]}" "$node_id" >/dev/null || {
        echo "Current node resource limits could not be restored." >&2
        exit 1
      }
    fi
    credential_wait=${BITCOIN_STACK_CREDENTIAL_WAIT_SECONDS:-300}
    [[ "$credential_wait" =~ ^[0-9]+$ ]] && [ "$credential_wait" -ge 1 ] && [ "$credential_wait" -le 3600 ] || {
      echo "Invalid credential readiness timeout." >&2
      exit 1
    }
    credential_deadline=$((SECONDS + credential_wait))
    while true; do
      credential_ready=1
      for service in "${services[@]}"; do
        service_id=$(container_id "$service")
        [ -n "$service_id" ] && [ "$(docker inspect --format '{{.State.Status}} {{if .State.Health}}{{.State.Health.Status}}{{end}}' "$service_id" 2>/dev/null || true)" = "running healthy" ] || credential_ready=0
      done
      [ "$credential_ready" = 0 ] || break
      [ "$SECONDS" -lt "$credential_deadline" ] || {
        echo "Credential services did not become ready." >&2
        exit 1
      }
      sleep 2
    done
    approve_current_config
    unlock_config
    ;;
  upgrade) do_upgrade ;;
  package-upgrade) package_upgrade ;;
  pull)
    lock_config
    "$stack_root/configure.sh"
    pull_images "$@"
    unlock_config
    ;;
  upgrade-agent) upgrade_agent ;;
  host-service) host_service ;;
  status) status ;;
  doctor) doctor ;;
  backup) guard_package_containers && do_backup ;;
  restore) guard_package_containers && do_restore "$@" ;;
  utxo-seed) guard_package_containers && utxo_seed "$@" ;;
  utxo-chainstate-copy)
    { [ "${1:-}" = dogecoin ] || [ "${1:-}" = bitcoincash ]; } && [ $# = 1 ] || {
      echo "Usage: $stack_command utxo-chainstate-copy dogecoin | bitcoincash" >&2
      exit 1
    }
    utxo_select_chain "$1"
    utxo_seed_overlay_enabled || {
      echo "The $utxo_name balance index is off; nothing was changed." >&2
      exit 1
    }
    guard_package_containers && utxo_chainstate_copy "$1"
    ;;
  utxo-index)
    case "${1:-}" in
      remove)
        shift
        guard_package_containers && utxo_index_remove "$@"
        ;;
      bench)
        shift
        guard_package_containers && utxo_index_bench "$@"
        ;;
      verify)
        shift
        guard_package_containers && utxo_index_verify "$@"
        ;;
      *)
        echo "Usage: $stack_command utxo-index remove [litecoin | bitcoincash | dogecoin] [-y] | bench <wallets.json> [--chain bitcoin|litecoin] [--scan [-y]] [--repeat N] | verify [--chain bitcoin|litecoin|dogecoin|bitcoincash] [-y]" >&2
        exit 1
        ;;
    esac
    ;;
  help | --help | -h) usage ;;
  *)
    echo "Unknown command: $cmd"
    usage
    exit 1
    ;;
esac
