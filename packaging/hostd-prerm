#!/bin/sh
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

case "${1:-}" in remove | deconfigure) ;; *) exit 0 ;; esac
[ -d /run/systemd/system ] || exit 0
systemctl disable --now node-manager-host-stats.timer >/dev/null 2>&1 || true
systemctl stop node-manager-host-stats.service >/dev/null 2>&1 || true
exit 0
