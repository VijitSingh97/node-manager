[Unit]
Description=Refresh Node Manager LAN port controls

[Timer]
OnBootSec=1min
# The dashboard ignores a host capability older than 90 s; requests start from node-manager-port-control.path.
OnUnitActiveSec=60s
RandomizedDelaySec=2s
Persistent=true
Unit=node-manager-port-control.service

[Install]
WantedBy=timers.target
