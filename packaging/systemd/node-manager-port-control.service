[Unit]
Description=Apply Node Manager LAN port settings
After=docker.service
Requires=docker.service
ConditionPathExists=/var/lib/node-manager/.env

[Service]
Type=oneshot
Environment=BITCOIN_STACK_ROOT=/usr/lib/node-manager
Environment=BITCOIN_STACK_STATE_DIR=/var/lib/node-manager
Environment=BITCOIN_STACK_CONFIG_DIR=/etc/node-manager
Environment=BITCOIN_STACK_PACKAGE_MANAGED=1
Environment=BITCOIN_STACK_DATA_DIR=/var/lib/node-manager/data
ExecStart=/usr/lib/node-manager/node-port-control
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/node-manager /var/lib/node-manager
RestrictAddressFamilies=AF_UNIX AF_NETLINK
